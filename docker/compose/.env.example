# App & ports
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
API_GATEWAY_HOST_PORT=8080
BUSINESS_SERVICE_HOST_PORT=8081
AI_SERVICE_HOST_PORT=8082
PUBLISHER_SERVICE_HOST_PORT=8083
SPRING_PROFILES_ACTIVE=docker

# Monitoring
# Shared monitoring agent URL (HTTPS in production); empty enables manual entry.
MONITORING_PUBLIC_API_URL=

# PostgreSQL
POSTGRES_DB=brandhub
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

# pgAdmin (optional add-on: shared/pgadmin.yaml)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_HOST_PORT=5050

# MongoDB (Dev: self-hosted Docker container | Prod: MongoDB Atlas)
# To switch to MongoDB Atlas: set MONGODB_URI to your Atlas connection string
# and leave MONGODB_DOCKER_URI empty.
MONGODB_HOST_PORT=27017
MONGODB_DATABASE=brandhub
MONGODB_URI=mongodb://localhost:27017/brandhub
MONGODB_DOCKER_URI=mongodb://mongodb:27017/brandhub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_HOST_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# ChromaDB (included in dev-ai)
CHROMADB_HOST_PORT=8000

# Neo4j (optional add-on: shared/neo4j.yaml)
NEO4J_AUTH=
NEO4J_HOST_PORT_BOLT=7687
NEO4J_HOST_PORT_HTTP=7474

# Security
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
AES_SECRET_KEY=
INTERNAL_SERVICE_KEY=

# AI providers
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
STABILITY_AI_API_KEY=
GOOGLE_VEO_API_KEY=

# Social OAuth (4 supported platforms: Facebook, Instagram, TikTok, Threads)
META_APP_ID=
META_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/oauth2/facebook
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/oauth2/instagram
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/oauth2/tiktok
THREADS_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/oauth2/threads

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/google

# SePay (VietQR)
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=brandhub-media
AWS_S3_REGION=ap-southeast-1

# Rate limits
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_TEXT_RATE_LIMIT_PER_MINUTE=20
AI_IMAGE_RATE_LIMIT_PER_MINUTE=5
AI_VIDEO_RATE_LIMIT_PER_MINUTE=2
PUBLISH_RATE_LIMIT_PER_MINUTE=10

# Publisher
MAX_RETRY_ATTEMPTS=3
PUBLISH_INTERVAL_MS=5000

# SMTP & password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_SECONDS=
