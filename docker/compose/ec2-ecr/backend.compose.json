{
  "name": "brandhub-backend",
  "services": {
    "api-gateway": {
      "restart": "unless-stopped",
      "container_name": "brandhub-api-gateway",
      "command": null,
      "entrypoint": null,
      "networks": {
        "brandhub-network": null
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://localhost:8080/actuator/health || exit 1"
        ],
        "timeout": "10s",
        "interval": "30s",
        "retries": 3,
        "start_period": "1m0s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "821014378805.dkr.ecr.ap-southeast-1.amazonaws.com/brandhub/api-gateway:deploy-20261029",
      "mem_limit": "640m",
      "env_file": [
        {
          "path": "./env/api-gateway.env",
          "required": true
        }
      ]
    },
    "nginx": {
      "image": "nginx:stable-alpine",
      "restart": "unless-stopped",
      "ports": [
        {
          "target": 80,
          "published": "80",
          "protocol": "tcp"
        },
        {
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "./nginx.conf",
          "target": "/etc/nginx/conf.d/default.conf",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "./acme-webroot",
          "target": "/var/www/certbot",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "./letsencrypt",
          "target": "/etc/letsencrypt",
          "read_only": true
        }
      ],
      "networks": [
        "brandhub-network"
      ],
      "depends_on": [
        "api-gateway"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "networks": {
    "brandhub-network": {
      "name": "brandhub-network",
      "driver": "bridge",
      "ipam": {}
    }
  }
}