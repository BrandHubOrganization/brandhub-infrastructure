# Custom ChromaDB image with non-root user (per BrandHub docker conventions).
# Upstream chromadb/chroma runs as root — this extends it with a dedicated user.
FROM chromadb/chroma:0.6.3

# ChromaDB base image uses Debian. Create non-root system user and grant
# ownership of the default data directory so persistence works without root.
RUN adduser --system --group --no-create-home chroma \
    && chown -R chroma:chroma /chroma

USER chroma
