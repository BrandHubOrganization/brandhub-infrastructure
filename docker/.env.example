# ============================================================
# BrandHub Docker environment example
# Copy this file to .env before running Docker Compose.
# ============================================================

# === Runtime profile ===
SPRING_PROFILES_ACTIVE=docker

# === Docker host ports ===
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PGADMIN_HOST_PORT=5050
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
CHROMADB_HOST_PORT=8000
API_GATEWAY_HOST_PORT=8080
BUSINESS_SERVICE_HOST_PORT=8081
AI_SERVICE_HOST_PORT=8082
PUBLISHER_SERVICE_HOST_PORT=8083
WEB_DASHBOARD_HOST_PORT=3000

# === PostgreSQL ===
POSTGRES_DB=brandhub
POSTGRES_USER=
POSTGRES_PASSWORD=

# === MongoDB Atlas ===
# Get the connection string from Atlas Dashboard > Cluster > Connect > Drivers.
MONGODB_URI=
MONGODB_DATABASE=brandhub

# === Internal service URLs ===
BUSINESS_SERVICE_URL=http://business-service:8081
AI_SERVICE_URL=http://ai-service:8082

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# === RabbitMQ ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# === Security ===
# Dán nội dung PEM (không xuống dòng, gộp thành 1 dòng) — không dùng file .pem nữa
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
AES_SECRET_KEY=
INTERNAL_SERVICE_KEY=

# === Rate limiting ===
# Default API traffic limit. Apply per authenticated user when possible, fallback to IP for anonymous requests.
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
# Auth endpoints should be stricter to reduce brute-force and credential stuffing risk.
AUTH_RATE_LIMIT_PER_MINUTE=5
# AI generation endpoints are expensive, so keep limits lower than normal APIs.
AI_TEXT_RATE_LIMIT_PER_MINUTE=20
AI_IMAGE_RATE_LIMIT_PER_MINUTE=5
AI_VIDEO_RATE_LIMIT_PER_MINUTE=2
# Publishing calls can trigger external social APIs, so limit them separately.
PUBLISH_RATE_LIMIT_PER_MINUTE=10
PUBLISH_INTERVAL_MS=5000
MAX_RETRY_ATTEMPTS=3

# === AWS S3 ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=brandhubmedia
AWS_S3_REGION=ap-southeast-1

# === LLM providers ===
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# === Image / Video generation ===
STABILITY_AI_API_KEY=
GOOGLE_VEO_API_KEY=

# === Social OAuth ===
META_APP_ID=
META_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/oauth2/facebook
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/oauth2/instagram
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/oauth2/tiktok
THREADS_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/oauth2/threads

# === Legacy service port aliases ===
# Kept for compatibility with older local configs.
SERVER_PORT_GATEWAY=8080
SERVER_PORT_BUSINESS=8081
SERVER_PORT_AI=8082
SERVER_PORT_PUBLISHER=8083

# === PAYOS ===
PAYOS_CLIENT_ID=your_client_id
PAYOS_API_KEY=your_api_key
PAYOS_CHECKSUM_KEY=your_checksum_key
PAYOS_WEBHOOK_URL=https://your-domain.com/api/webhooks/payos