# === MongoDB ===
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me
MONGODB_URI=mongodb://brandhub_user:change_me@mongo:27017/brandhub?authSource=brandhub
MONGODB_DATABASE=brandhub

# === PostgreSQL ===
POSTGRES_DB=brandhub
POSTGRES_USER=brandhub
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_HOST_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# === RabbitMQ ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=brandhub
RABBITMQ_PASSWORD=change_me

# === JWT ===
JWT_SECRET=change-me-minimum-256-bit-secret-key-here-!!
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# === AES (OAuth token encryption) ===
AES_SECRET_KEY=change-me-exactly-32-characters!

# === Internal service auth ===
INTERNAL_SERVICE_KEY=change-me-internal-shared-key

# === AWS S3 ===
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=brandhub-media
AWS_S3_REGION=ap-southeast-1

# === LLM ===
GROQ_API_KEY=your_groq_key
ANTHROPIC_API_KEY=your_claude_key
LLM_PROVIDER=groq

# === Image / Video Gen ===
STABILITY_AI_API_KEY=your_stability_key
GOOGLE_VEO_API_KEY=your_veo_key

# === Social OAuth ===
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/callback/facebook
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/callback/instagram
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/callback/tiktok
THREADS_REDIRECT_URI=http://localhost:8080/api/v1/social-accounts/callback/threads
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_secret

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@brandhub.com
PGADMIN_DEFAULT_PASSWORD=change_me_to_a_strong_password
PGADMIN_HOST_PORT=5050

# === Rate limiting ===
RATE_LIMIT_PER_MINUTE=100
PUBLISH_INTERVAL_MS=5000
MAX_RETRY_ATTEMPTS=3

# === Server ports ===
SERVER_PORT_GATEWAY=8080
SERVER_PORT_BUSINESS=8081
SERVER_PORT_AI=8082
SERVER_PORT_PUBLISHER=8083
