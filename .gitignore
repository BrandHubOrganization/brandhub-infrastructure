# ── Secrets & Environment Files ───────────────────────────────
.env
.env.*
!.env.example
!docker/compose/.env.example

# ── Node / Docs Site (VitePress) ──────────────────────────────
node_modules/
dist/
.vitepress/cache/
.vitepress/dist/
docs-site/node_modules/
docs-site/.vitepress/cache/
docs-site/.vitepress/dist/
docs-site/dist/
docs-site/docs-tree.json

# Note: docs/plan/jira-status.json is intentionally tracked for the docs-site workload dashboard.

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# ── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Local-only operational scratch ────────────────────────────
# Machine-specific repairs, funding scripts, inventories, and verification artifacts.
keep-local-only/

# ── Docker local data directories ─────────────────────────────
postgres-data/
mongo-data/
redis-data/

# ── Security: private credentials & database snapshots ────────
*.dump
*.rdb
*.p12
*.pfx
*.jks
database/backups/*.sql
database/backups/*.ejson
**/backups/*.sql
**/backups/*.ejson
**/backups/*.bson
**/backups/*.archive
**/backups/*.gz
**/backups/*.zip

# ── Terraform variable files & local backups ──────────────────
*.tfvars
*.tfvars.bak*
!*.tfvars.example
*.bak*
