{
  "name": "brandhub-ai",
  "services": {
    "ai-service": {
      "init": true,
      "restart": "unless-stopped",
      "container_name": "brandhub-ai-service",
      "image": "${AI_IMAGE:?Set AI_IMAGE}",
      "env_file": [
        {
          "path": "./env/ai-service.env",
          "required": true
        }
      ],
      "environment": {
        "TREND_RUN_DIR": "/app/data/crawler/trend_runs",
        "CRAWLER_API_URL": "http://172.31.24.149:8084",
        "HF_HOME": "/home/appuser/.cache/huggingface",
        "HF_HUB_CACHE": "/home/appuser/.cache/huggingface/hub",
        "SENTENCE_TRANSFORMERS_HOME": "/home/appuser/.cache/huggingface/hub"
      },
      "extra_hosts": [
        "redis:172.31.24.149",
        "rabbitmq:172.31.24.149",
        "chromadb:172.31.24.149"
      ],
      "mem_limit": "3g",
      "memswap_limit": "3g",
      "cpus": 1.8,
      "ports": [
        {
          "target": 8082,
          "published": "8082",
          "host_ip": "172.31.20.60",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "ai-data",
          "target": "/app/data"
        },
        {
          "type": "volume",
          "source": "ai-model-cache",
          "target": "/home/appuser/.cache"
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:8082/health')"
        ],
        "timeout": "5s",
        "interval": "15s",
        "retries": 3,
        "start_period": "60s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "volumes": {
    "ai-data": {
      "name": "brandhub-ai-data"
    },
    "ai-model-cache": {
      "name": "brandhub-ai-model-cache"
    }
  }
}
