{
  "name": "brandhub-core",
  "services": {
    "business-service": {
      "restart": "unless-stopped",
      "container_name": "brandhub-business-service",
      "command": null,
      "entrypoint": null,
      "networks": {
        "brandhub-network": null
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "rabbitmq": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://localhost:8081/actuator/health || exit 1"
        ],
        "timeout": "10s",
        "interval": "30s",
        "retries": 3,
        "start_period": "1m30s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "${BUSINESS_IMAGE:?Set BUSINESS_IMAGE}",
      "mem_limit": "1100m",
      "ports": [
        {
          "target": 8081,
          "published": "8081",
          "host_ip": "172.31.24.149",
          "protocol": "tcp"
        }
      ],
      "env_file": [
        {
          "path": "./env/business-service.env",
          "required": true
        }
      ],
      "environment": {
        "AI_SERVICE_URL": "http://172.31.20.60:8082",
        "AWS_S3_BUCKET": "brandhub-media-134875421878",
        "AWS_S3_AI_BUCKET": "brandhub-media-134875421878",
        "REPOSITORY_STORAGE_SYSTEMS3_BUCKET": "brandhub-media-134875421878",
        "AWS_S3_REGION": "ap-southeast-1",
        "AWS_S3_LOCAL_FALLBACK_ENABLED": "false",
        "PUBLIC_API_BASE_URL": "https://api.brandhub.id.vn",
        "REPOSITORY_MEDIA_PUBLIC_BASE_URL": "https://api.brandhub.id.vn",
        "MAIL_ALLOWED_IMAGE_HOSTS": "brandhub-media-134875421878.s3.ap-southeast-1.amazonaws.com,api.brandhub.id.vn"
      }
    },
    "chromadb": {
      "restart": "unless-stopped",
      "container_name": "brandhub-chromadb",
      "command": null,
      "entrypoint": null,
      "environment": {
        "ANONYMIZED_TELEMETRY": "FALSE"
      },
      "image": "chromadb/chroma:1.5.9",
      "networks": {
        "brandhub-network": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "chroma-data",
          "target": "/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "bash",
          "-ec",
          "exec 3<>/dev/tcp/127.0.0.1/8000\nprintf 'GET /api/v2/heartbeat HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3\nread -r -t 4 health_status <&3\n[[ \"$$health_status\" == *\" 200 \"* ]]\n"
        ],
        "timeout": "5s",
        "interval": "15s",
        "retries": 3,
        "start_period": "10s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "512m",
      "ports": [
        {
          "target": 8000,
          "published": "8000",
          "host_ip": "172.31.24.149",
          "protocol": "tcp"
        }
      ]
    },
    "postgres": {
      "restart": "unless-stopped",
      "container_name": "brandhub-postgres",
      "command": null,
      "entrypoint": null,
      "image": "postgres:17-alpine",
      "networks": {
        "brandhub-network": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "postgres_data",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 5,
        "start_period": "10s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "640m",
      "env_file": [
        {
          "path": "./env/postgres.env",
          "required": true
        }
      ]
    },
    "publisher-service": {
      "restart": "unless-stopped",
      "container_name": "brandhub-publisher-service",
      "command": null,
      "entrypoint": null,
      "networks": {
        "brandhub-network": null
      },
      "depends_on": {
        "rabbitmq": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://localhost:8083/actuator/health || exit 1"
        ],
        "timeout": "10s",
        "interval": "30s",
        "retries": 3,
        "start_period": "1m0s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "${PUBLISHER_IMAGE:?Set PUBLISHER_IMAGE}",
      "mem_limit": "600m",
      "ports": [
        {
          "target": 8083,
          "published": "8083",
          "host_ip": "172.31.24.149",
          "protocol": "tcp"
        }
      ],
      "env_file": [
        {
          "path": "./env/publisher-service.env",
          "required": true
        }
      ],
      "environment": {
        "BUSINESS_SERVICE_URL": "http://business-service:8081",
        "PUBLIC_MEDIA_BASE_URL": "https://api.brandhub.id.vn"
      }
    },
    "rabbitmq": {
      "restart": "unless-stopped",
      "container_name": "brandhub-rabbitmq",
      "command": null,
      "entrypoint": null,
      "image": "rabbitmq:3.12-management-alpine",
      "networks": {
        "brandhub-network": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "rabbitmq-data",
          "target": "/var/lib/rabbitmq",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "rabbitmq-diagnostics",
          "-q",
          "ping"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 5,
        "start_period": "20s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "512m",
      "env_file": [
        {
          "path": "./env/rabbitmq.env",
          "required": true
        }
      ],
      "ports": [
        {
          "target": 5672,
          "published": "5672",
          "host_ip": "172.31.24.149",
          "protocol": "tcp"
        }
      ]
    },
    "redis": {
      "restart": "unless-stopped",
      "container_name": "brandhub-redis",
      "command": [
        "exec redis-server --requirepass \"$$REDIS_PASSWORD\" --appendonly yes --maxmemory \"$$REDIS_MAXMEMORY\" --maxmemory-policy \"$$REDIS_MAXMEMORY_POLICY\""
      ],
      "entrypoint": [
        "/bin/sh",
        "-ec"
      ],
      "image": "redis:7.2-alpine",
      "networks": {
        "brandhub-network": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "redis-data",
          "target": "/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 5
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "ports": [
        {
          "target": 6379,
          "published": "6379",
          "host_ip": "172.31.24.149",
          "protocol": "tcp"
        }
      ],
      "mem_limit": "384m",
      "env_file": [
        {
          "path": "./env/redis.env",
          "required": true
        }
      ]
    },
    "db-backup": {
      "restart": "unless-stopped",
      "container_name": "brandhub-db-backup",
      "image": "${DB_BACKUP_IMAGE:?Set DB_BACKUP_IMAGE}",
      "env_file": [
        {
          "path": "./env/db-backup.env",
          "required": true
        }
      ],
      "environment": {
        "PGHOST": "postgres",
        "REDIS_HOST": "redis",
        "CHROMA_DATA_DIR": "/chroma",
        "BACKUP_BUCKET": "brandhub-db-backup-prd-134875421878",
        "AWS_REGION": "ap-southeast-1",
        "TZ": "Asia/Ho_Chi_Minh"
      },
      "networks": {
        "brandhub-network": null
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "volumes": [
        {
          "type": "volume",
          "source": "chroma-data",
          "target": "/chroma",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "db-backup-state",
          "target": "/var/lib/db-backup",
          "volume": {}
        }
      ],
      "mem_limit": "512m"
    }
  },
  "networks": {
    "brandhub-network": {
      "name": "brandhub-network",
      "driver": "bridge",
      "ipam": {}
    }
  },
  "volumes": {
    "chroma-data": {
      "name": "brandhub-chroma-data"
    },
    "postgres_data": {
      "name": "brandhub-postgres-v2-data"
    },
    "rabbitmq-data": {
      "name": "brandhub-rabbitmq-data"
    },
    "redis-data": {
      "name": "brandhub-redis-data"
    },
    "db-backup-state": {
      "name": "brandhub-db-backup-state"
    }
  }
}
