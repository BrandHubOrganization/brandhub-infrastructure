#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
  PY="python3"
elif command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
  PY="python"
else
  echo "[pre-push] ERROR: Python 3 is required. See SECURITY.md." >&2
  exit 1
fi

GITLEAKS="$(git config --get brandhub.gitleaksPath || true)"
if [ -z "$GITLEAKS" ]; then
  GITLEAKS="gitleaks"
fi
if ! "$GITLEAKS" version >/dev/null 2>&1; then
  echo "[pre-push] ERROR: gitleaks not found ($GITLEAKS). Install Gitleaks 8.30.1 or set 'git config --local brandhub.gitleaksPath /path/to/gitleaks'. See SECURITY.md." >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  if echo "$local_sha" | grep -Eq '^0+$'; then
    continue
  fi

  if echo "$remote_sha" | grep -Eq '^0+$'; then
    base_sha="$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null || git merge-base "$local_sha" refs/remotes/origin/develop 2>/dev/null || true)"
    if [ -n "$base_sha" ]; then
      range="${base_sha}..${local_sha}"
    else
      range="$local_sha"
    fi
  else
    range="${remote_sha}..${local_sha}"
  fi

  "$PY" scripts/security/check_sensitive_paths.py --history "$range"
  "$GITLEAKS" detect --log-opts="$range" --config .gitleaks.toml --redact=100 --no-banner
done
