  // BrandHub — Database Schema V2 (DBML for dbdiagram.io)
  // STATUS: DESIGN — chưa áp dụng vào scripts/init-postgres.sql thật.
  // Thiết kế cho nghiệp vụ V2: Agency -> Workspace -> Media Package -> Media Campaign -> Task
  // Nguồn: docs/BA/11-data-entities-glossary.md, docs/database/schema-v2/database-strategy.md
  //
  // PostgreSQL (23 tables — cập nhật 2026-09-16: tách ai_credit_ledgers thành +ai_credit_creator_limits):
  //   Identity:     users, user_oauth_providers, user_refresh_tokens, user_system_roles
  //   Organization: agencies, agency_members, agency_invitations, workspaces,
  //                 workspace_members, workspace_invitations, workspace_templates, client_profiles
  //   Commerce:     media_packages, workspace_media_packages, media_campaigns
  //   Collaborator: third_party_collaborators, campaign_collaborators
  //   Billing:      subscription_plans, user_subscriptions, transactions,
  //                 ai_credit_ledgers, ai_credit_creator_limits, audit_logs
  //
  // MongoDB (15 collections — cập nhật 2026-09-16: +livestream_sessions, +survey_forms, +survey_responses,
  //          +mail_templates, +ai_usage_logs field schema (trước chỉ nhắc tên)):
  //   business-service: tasks, task_approvals, posts, content_requests, material_repository,
  //                      brand_collections, hashtag_collections, content_versions,
  //                      livestream_sessions, survey_forms, survey_responses, mail_templates,
  //                      social_accounts, notifications
  //   ai-service:        knowledge_documents, ai_usage_logs
  //   publisher-service: publish_logs

  // ============================================================
  // ENUMS
  // ============================================================

  Enum user_status {
    ACTIVE
    SUSPENDED
    DELETED
  }

  Enum oauth_provider {
    GOOGLE
    FACEBOOK
  }

  Enum workspace_member_role {
    MANAGER
    CREATOR
    CLIENT
  }

  Enum agency_member_role {
    OWNER
    MEMBER
  }

  Enum entity_status {
    ACTIVE
    SOFT_DELETED
    INACTIVE
  }

  Enum invitation_status {
    PENDING
    ACCEPTED
    EXPIRED
    REVOKED
  }

  Enum package_negotiation_status {
    DRAFT
    CLIENT_REQUESTED_CHANGE
    AGENCY_COUNTERED
    APPROVED
  }

  Enum package_type {
    BY_DURATION
    BY_BUDGET
    FULL_DELEGATION
  }

  Enum campaign_status {
    DRAFT
    APPROVED
    IN_PROGRESS
    COMPLETED
  }

  Enum content_request_status {
    PENDING
    IN_PROGRESS
    ACCEPTED
    DENIED
  }

  Enum task_type {
    POST
    LIVESTREAM
    SURVEY
  }

  Enum task_source_type {
    CAMPAIGN
    CONTENT_REQUEST
    MANUAL
  }

  Enum task_status {
    BACKLOG
    DETAIL_IDENTIFIED
    ASSIGNED
    IN_PROGRESS
    QC_REVIEW
    MANAGER_REVIEW
    CLIENT_REVIEW
    COMPLETED
  }

  Enum task_approval_step {
    CREATOR
    QC
    MANAGER
    CLIENT
  }

  Enum task_approval_action {
    SUBMIT
    APPROVE
    REJECT
  }

  Enum collaborator_type {
    NEWSPAPER
    BANNER
    TV
    OTHER
  }

  Enum cooperation_status {
    CONTACTED
    NEGOTIATING
    CONFIRMED
    LIVE
  }

  Enum subscription_plan_name {
    BASIC
    PRO
    ENTERPRISE
  }

  Enum subscription_status {
    ACTIVE
    EXPIRED
    CANCELLED
    TRIALING
  }

  Enum transaction_status {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
  }

  Enum transaction_type {
    UPGRADE_PLAN
    BUY_CREDIT
  }

  Enum audit_action {
    LOGIN
    LOGOUT
    TOKEN_REFRESH
    PASSWORD_RESET
    CREATE
    UPDATE
    DELETE
    ROLE_CHANGE
    PERMISSION_CHANGE
  }

  Enum social_platform {
    FACEBOOK
    INSTAGRAM
    TIKTOK
    THREADS
  }

  Enum social_account_status {
    ACTIVE
    EXPIRING_SOON
    EXPIRED
    REVOKED
  }

  Enum post_publish_status {
    PENDING
    IN_PROGRESS
    DONE
    FAIL
  }

  Enum livestream_sub_status {
    PRE_LIVE
    LIVE
    POST_LIVE
    DONE
    CANCEL
  }

  Enum post_content_subtype {
    POST
    STORY
    REELS
  }

  Enum mail_template_type {
    CUSTOM
    SYSTEM_DEFAULT
  }

  Enum ai_usage_feature {
    GENERATE_CAPTION
    GENERATE_IMAGE
    GENERATE_VIDEO
    GENERATE_AMBASSADOR
  }

  Enum notification_type {
    TASK_ASSIGNED
    TASK_APPROVAL_NEEDED
    TASK_REJECTED
    PACKAGE_APPROVAL_NEEDED
    CAMPAIGN_APPROVAL_NEEDED
    CONTENT_REQUEST_DENIED
    POST_PUBLISHED
    POST_FAILED
    AGENCY_INVITE
    WORKSPACE_INVITE
    SUBSCRIPTION_EXPIRING
  }

  // ============================================================
  // POSTGRESQL — IDENTITY (4 tables, không đổi so với V1)
  // ============================================================

  Table users [note: 'PostgreSQL — Identity — business-service'] {
    id                    uuid         [pk, default: `gen_random_uuid()`]
    email                 varchar(255) [unique, not null]
    password_hash         varchar      [note: 'null if OAuth-only']
    full_name             varchar(255) [not null]
    avatar_url            varchar
    status                user_status  [not null, default: 'ACTIVE']
    is_active             boolean      [not null, default: true]
    preferences           jsonb        [not null, default: '{}']
    last_login_at         timestamptz
    last_password_change  timestamptz
    otp_code              varchar(6)
    otp_expiry            timestamptz
    email_verified_at     timestamptz
    created_at            timestamptz  [not null, default: `now()`]
    updated_at            timestamptz  [not null, default: `now()`]

    indexes { email [unique] }
  }

  Table user_oauth_providers [note: 'PostgreSQL — Identity — 1NF split from users'] {
    id          uuid           [pk, default: `gen_random_uuid()`]
    user_id     uuid           [not null, ref: > users.id]
    provider    oauth_provider [not null]
    provider_id varchar(255)   [not null]
    created_at  timestamptz    [not null, default: `now()`]

    indexes {
      user_id
      (provider, provider_id) [unique]
    }
  }

  Table user_refresh_tokens [note: 'PostgreSQL — Identity — 1NF split from users'] {
    id          uuid         [pk, default: `gen_random_uuid()`]
    user_id     uuid         [not null, ref: > users.id]
    token_hash  varchar(255) [not null, unique]
    jti         varchar(255) [not null, unique]
    expires_at  timestamptz  [not null]
    device_info jsonb        [not null, default: '{}']
    created_at  timestamptz  [not null, default: `now()`]

    indexes {
      user_id
      jti [unique]
      expires_at
    }
  }

  Table user_system_roles [note: 'PostgreSQL — Identity — ADMIN/USER system-level only'] {
    id          uuid        [pk, default: `gen_random_uuid()`]
    user_id     uuid        [not null, unique, ref: > users.id]
    system_role varchar(50) [not null, default: 'USER', note: 'CHECK IN (ADMIN, USER)']
    granted_by  uuid        [ref: > users.id]
    granted_at  timestamptz [not null, default: `now()`]

    indexes { user_id [unique] }
  }

  // ============================================================
  // POSTGRESQL — ORGANIZATION: AGENCY & WORKSPACE (NEW group V2)
  // ============================================================

  Table agencies [note: 'PostgreSQL — Organization — NEW V2 — anchor, mỗi Agency đúng 1 Owner'] {
    id          uuid          [pk, default: `gen_random_uuid()`]
    name        varchar(255)  [not null]
    owner_id    uuid          [not null, ref: > users.id, note: '1 Agency = 1 Owner cố định']
    logo_url    varchar
    description text
    status      entity_status [not null, default: 'ACTIVE']
    deleted_at  timestamptz   [note: 'soft delete, khôi phục 30 ngày']
    created_at  timestamptz   [not null, default: `now()`]
    updated_at  timestamptz   [not null, default: `now()`]

    indexes { owner_id }
  }

  Table agency_members [note: 'PostgreSQL — Organization — NEW V2 — junction, role OWNER/MEMBER (đổi 2026-09-16, xem 01-organization-structure.md)'] {
    id         uuid              [pk, default: `gen_random_uuid()`]
    agency_id  uuid              [not null, ref: > agencies.id]
    user_id    uuid              [not null, ref: > users.id]
    role       agency_member_role [not null, default: 'MEMBER', note: 'OWNER trùng agencies.owner_id — lưu tường minh ở đây để query role không cần JOIN ngược agencies']
    joined_at  timestamptz       [not null, default: `now()`]

    indexes { (agency_id, user_id) [unique] }
  }

  Table agency_invitations [note: 'PostgreSQL — Organization — NEW V2 — hết hạn 3 ngày'] {
    id            uuid               [pk, default: `gen_random_uuid()`]
    agency_id     uuid               [not null, ref: > agencies.id]
    invited_email varchar(255)       [not null]
    invited_by    uuid               [not null, ref: > users.id]
    token         varchar(255)       [not null, unique]
    status        invitation_status  [not null, default: 'PENDING']
    expires_at    timestamptz        [not null, note: '3 ngày từ created_at']
    accepted_at   timestamptz
    created_at    timestamptz        [not null, default: `now()`]

    indexes {
      agency_id
      token [unique]
      (agency_id, invited_email) [unique]
    }
  }

  Table workspaces [note: 'PostgreSQL — Organization — ĐỔI V2: agency_id FK thay vì đứng độc lập'] {
    id                     uuid          [pk, default: `gen_random_uuid()`]
    agency_id              uuid          [not null, ref: > agencies.id]
    name                   varchar(255)  [not null]
    created_by             uuid          [not null, ref: > users.id, note: 'audit ai tạo — theo BA chỉ agencies.owner_id được tạo Workspace, nhưng lưu tường minh nhất quán pattern các bảng khác']
    workspace_media_package_id uuid      [ref: > workspace_media_packages.id, note: 'nullable lúc mới tạo — suy ra qua workspace_media_packages.workspace_id (unique 1-1), KHÔNG trỏ thẳng media_packages (tránh 2 nguồn nói khác nhau về Package đang áp dụng)']
    timezone_config        varchar(100)  [not null, default: 'Asia/Ho_Chi_Minh']
    settings               jsonb         [not null, default: '{}']
    status                 entity_status [not null, default: 'ACTIVE']
    deleted_at             timestamptz
    created_at             timestamptz   [not null, default: `now()`]
    updated_at             timestamptz   [not null, default: `now()`]

    indexes { agency_id }
  }

  Table workspace_members [note: 'PostgreSQL — Organization — ĐỔI V2: role theo TỪNG Workspace, gộp CLIENT vào đây'] {
    id                 uuid                   [pk, default: `gen_random_uuid()`]
    workspace_id       uuid                   [not null, ref: > workspaces.id]
    user_id            uuid                   [ref: > users.id, note: 'nullable nếu role=CLIENT chưa tự đăng ký, dùng client_profile_id']
    client_profile_id  uuid                   [ref: > client_profiles.id, note: 'chỉ set khi role=CLIENT']
    role               workspace_member_role  [not null]
    added_by           uuid                   [ref: > users.id, note: '2 nguồn insert khác nhau (2026-09-16 xác nhận): role=MANAGER/CREATOR → added_by là OWNER/MANAGER GÁN THẲNG (FR 3.4.19, có hiệu lực ngay, KHÔNG qua workspace_invitations). role=CLIENT → hàng này chỉ tạo SAU KHI invitation được accept, added_by = invited_by của workspace_invitations tương ứng.']
    joined_at          timestamptz
    is_active          boolean                [not null, default: true]
    created_at         timestamptz            [not null, default: `now()`]
    updated_at         timestamptz            [not null, default: `now()`]

    Note: 'CHECK constraint bắt buộc ở DDL thật: (role = CLIENT AND client_profile_id IS NOT NULL AND user_id IS NULL) OR (role != CLIENT AND user_id IS NOT NULL AND client_profile_id IS NULL) — đúng 1 trong 2 identity cột theo role, không được cả 2 hoặc cả 2 đều NULL. Không còn role OWNER ở tầng Workspace (2026-09-16 xác nhận) — Owner của Agency tham gia 1 Workspace thì mang role MANAGER hoặc CREATOR như người thường, OWNER chỉ tồn tại ở agencies.owner_id/agency_members.role. PARTIAL UNIQUE bổ sung ở DDL thật (không biểu diễn được trong DBML indexes block): CREATE UNIQUE INDEX ON workspace_members(workspace_id) WHERE role = MANAGER AND is_active = true — tối đa 1 Manager active/workspace, không co-manage.'

    indexes {
      workspace_id
      (workspace_id, user_id) [unique]
      (workspace_id, client_profile_id) [unique]
    }
  }

  Table workspace_invitations [note: 'PostgreSQL — Organization — SỬA 2026-09-16: CHỈ dành cho CLIENT (actor ngoài Agency). MANAGER/CREATOR không qua bảng này — OWNER/MANAGER gán thẳng vào workspace_members (FR 3.4.19 Add Workspace Member, có hiệu lực ngay, không cần accept/token/expires_at).'] {
    id            uuid         [pk, default: `gen_random_uuid()`]
    workspace_id  uuid         [not null, ref: > workspaces.id]
    invited_email varchar(255) [not null, note: 'email của Client được mời — Client ở ngoài Agency, chưa chắc đã có user_id']
    invited_by    uuid         [not null, ref: > users.id, note: 'luôn là OWNER hoặc MANAGER của workspace, theo BA file 04 mục 1: Manager invite Client']
    token         varchar(255) [not null, unique]
    status        invitation_status [not null, default: 'PENDING']
    expires_at    timestamptz  [not null]
    accepted_at   timestamptz
    created_at    timestamptz  [not null, default: `now()`]

    indexes {
      workspace_id
      token [unique]
      (workspace_id, invited_email) [unique]
    }
  }

  Table workspace_templates [note: 'PostgreSQL — Organization — NEW V2 — lưu cấu hình Workspace để tái sử dụng'] {
    id             uuid         [pk, default: `gen_random_uuid()`]
    agency_id      uuid         [not null, ref: > agencies.id]
    name           varchar(255) [not null]
    source_workspace_id uuid    [ref: > workspaces.id, note: 'Workspace gốc được lưu thành template']
    config_snapshot jsonb       [not null, note: 'snapshot settings tại thời điểm lưu']
    created_by     uuid         [not null, ref: > users.id]
    created_at     timestamptz  [not null, default: `now()`]

    indexes { agency_id }
  }

  Table client_profiles [note: 'PostgreSQL — Organization — NEW V2 — tách bảng riêng khỏi users, tái sử dụng xuyên Agency'] {
    id              uuid         [pk, default: `gen_random_uuid()`]
    linked_user_id  uuid         [ref: > users.id, note: 'nullable — set khi Client tự đăng ký/liên kết account']
    display_name    varchar(255) [not null]
    email           varchar(255) [not null, note: 'CỐ ĐỊNH, không đổi được qua FR 3.3.4 — unique KHÔNG áp toàn cục (1 email có thể là Client của nhiều Agency khác nhau)']
    company         varchar(255)
    brand_name      varchar(255) [note: 'thương hiệu đại diện — carry-over từ clients.brand_name V1']
    industry        varchar(100) [note: 'carry-over từ clients.industry V1']
    logo_url        varchar      [note: 'carry-over từ clients.logo_url V1']
    phone           varchar(50)
    note            text
    created_at      timestamptz  [not null, default: `now()`]
    updated_at      timestamptz  [not null, default: `now()`]

    indexes {
      linked_user_id
      email
    }
  }

  // ============================================================
  // POSTGRESQL — COMMERCE: MEDIA PACKAGE & CAMPAIGN (NEW V2)
  // ============================================================

  Table media_packages [note: 'PostgreSQL — Commerce — NEW V2 — gộp Template+Custom 1 bảng (xem database-strategy.md mục 4.3)'] {
    id                 uuid         [pk, default: `gen_random_uuid()`]
    name               varchar(255) [not null]
    is_template        boolean      [not null, default: false, note: 'true=Admin template dùng chung, false=custom riêng 1 Workspace']
    package_type       package_type [not null]
    duration_weeks     int
    budget_amount      decimal(14,2)
    scope_description  text
    created_by         uuid         [not null, ref: > users.id, note: 'Admin cho template, Owner/Manager cho custom']
    created_at         timestamptz  [not null, default: `now()`]
    updated_at         timestamptz  [not null, default: `now()`]

    indexes { is_template }
  }

  Table workspace_media_packages [note: 'PostgreSQL — Commerce — NEW V2 — đàm phán, ACID 2-bên-approve (Hard Rule 4)'] {
    id                     uuid                        [pk, default: `gen_random_uuid()`]
    workspace_id           uuid                        [not null, unique, ref: > workspaces.id]
    package_id             uuid                        [not null, ref: > media_packages.id]
    negotiation_status     package_negotiation_status  [not null, default: 'DRAFT']
    final_terms            jsonb                       [not null, default: '{}', note: 'giá/thời gian/hình thức đã chốt']
    approved_by_agency_at  timestamptz                 [note: 'NULL cho tới khi Owner/Manager approve bản mới nhất']
    approved_by_client_at  timestamptz                 [note: 'NULL cho tới khi Client approve bản mới nhất — reset khi 1 bên sửa lại']
    created_at             timestamptz                 [not null, default: `now()`]
    updated_at             timestamptz                 [not null, default: `now()`]

    indexes { workspace_id [unique] }
  }

  Table media_campaigns [note: 'PostgreSQL — Commerce — NEW V2 — immutable sau approve (docs/ba/13 mục 6)'] {
    id                        uuid             [pk, default: `gen_random_uuid()`]
    workspace_media_package_id uuid            [not null, ref: > workspace_media_packages.id]
    name                      varchar(255)     [not null]
    strategy_detail           text
    brand_guideline           text
    timeline                  jsonb            [not null, default: '{}']
    status                    campaign_status  [not null, default: 'DRAFT']
    approved_by_agency_at     timestamptz
    approved_by_client_at     timestamptz
    created_at                timestamptz      [not null, default: `now()`]
    updated_at                timestamptz      [not null, default: `now()`]

    indexes { workspace_media_package_id }
  }

  // ============================================================
  // POSTGRESQL — THIRD-PARTY COLLABORATOR (NEW V2, module hoàn toàn mới)
  // ============================================================

  Table third_party_collaborators [note: 'PostgreSQL — Collaborator — NEW V2 — danh bạ chung cấp Agency (docs/ba/13 mục 8)'] {
    id           uuid                [pk, default: `gen_random_uuid()`]
    agency_id    uuid                [not null, ref: > agencies.id]
    partner_name varchar(255)        [not null]
    partner_type collaborator_type   [not null]
    contact_info jsonb               [not null, default: '{}']
    notes        text
    created_by   uuid                [not null, ref: > users.id]
    created_at   timestamptz         [not null, default: `now()`]
    updated_at   timestamptz         [not null, default: `now()`]

    indexes { agency_id }
  }

  Table campaign_collaborators [note: 'PostgreSQL — Collaborator — NEW V2 — N-N, trạng thái theo TỪNG Campaign'] {
    id                  uuid                [pk, default: `gen_random_uuid()`]
    media_campaign_id   uuid                [not null, ref: > media_campaigns.id]
    collaborator_id     uuid                [not null, ref: > third_party_collaborators.id]
    cooperation_status  cooperation_status  [not null, default: 'CONTACTED']
    updated_by          uuid                [ref: > users.id]
    updated_at          timestamptz         [not null, default: `now()`]

    indexes { (media_campaign_id, collaborator_id) [unique] }
  }

  // ============================================================
  // POSTGRESQL — BILLING (đổi phạm vi gắn Plan: User thay vì Workspace)
  // ============================================================

  Table subscription_plans [note: 'PostgreSQL — Billing — master data, không đổi so với V1'] {
    id               uuid                     [pk, default: `gen_random_uuid()`]
    name             subscription_plan_name   [not null, unique]
    display_name     varchar(100)             [not null]
    price_monthly    decimal(12,2)            [not null]
    max_workspaces   int                      [not null, note: '-1 = unlimited. RULE (2026-09-16, không có FK trực tiếp): giới hạn TỔNG qua TẤT CẢ Agency của User đó — 1 User sở hữu N Agency (agencies.owner_id = user_id), mỗi Agency có M Workspace. Service layer tự tính: SELECT COUNT(*) FROM workspaces w JOIN agencies a ON w.agency_id = a.id WHERE a.owner_id = :userId, so với max_workspaces, KHÔNG phải giới hạn riêng từng Agency.']
    ai_credits_month int                      [not null, note: '-1 = unlimited. RULE (2026-09-16): giới hạn TỔNG credit/tháng qua TẤT CẢ Agency của User — service layer tính SUM(ai_credit_ledgers.used_amount) cùng month qua mọi agencies.id WHERE owner_id=:userId, so với ai_credits_month. Không denormalize cache — tính runtime qua JOIN.']
    features         jsonb                    [not null, default: '[]']
    is_active        boolean                  [not null, default: true]
    created_at       timestamptz              [not null, default: `now()`]

    indexes { name [unique] }
  }

  Table user_subscriptions [note: 'PostgreSQL — Billing — ĐỔI TÊN V2 từ workspace_subscriptions, gắn cấp User/Owner. RULE tổng hợp giới hạn (2026-09-16): xem note subscription_plans.max_workspaces/ai_credits_month — 1 User có thể sở hữu N Agency (agencies.owner_id), giới hạn Plan tính TỔNG qua toàn bộ Agency đó, KHÔNG có FK/bảng cache riêng, service layer JOIN runtime.'] {
    id                   uuid                 [pk, default: `gen_random_uuid()`]
    user_id              uuid                 [not null, unique, ref: > users.id, note: 'Plan áp dụng toàn bộ Agency của Owner này']
    plan_id              uuid                 [not null, ref: > subscription_plans.id]
    status               subscription_status  [not null, default: 'TRIALING']
    current_period_start timestamptz          [not null]
    current_period_end   timestamptz          [not null]
    cancelled_at         timestamptz
    created_at           timestamptz          [not null, default: `now()`]
    updated_at           timestamptz          [not null, default: `now()`]

    indexes {
      user_id [unique]
      (status, current_period_end)
    }
  }

  Table transactions [note: 'PostgreSQL — Billing — ĐỔI TÊN V2 từ payments, gộp invoices — PayOS, ACID'] {
    id             uuid                [pk, default: `gen_random_uuid()`]
    user_id        uuid                [not null, ref: > users.id]
    type           transaction_type    [not null]
    amount         decimal(12,2)       [not null]
    currency       varchar(3)          [not null, default: 'VND']
    status         transaction_status  [not null, default: 'PENDING']
    ref_id         varchar(255)        [note: 'planId khi upgrade, hoặc số lượng credit khi buy_credit']
    payos_tx_id    varchar(255)        [unique, note: 'External PayOS transaction ID']
    paid_at        timestamptz
    failed_reason  varchar
    created_at     timestamptz         [not null, default: `now()`]
    updated_at     timestamptz         [not null, default: `now()`]

    indexes {
      user_id
      payos_tx_id [unique]
    }
  }

  Table ai_credit_ledgers [note: 'PostgreSQL — Billing — NEW V2 — usage TỔNG Agency/tháng, reset hàng tháng KHÔNG rollover, KHÔNG gắn user (sửa 2026-09-16, tách khỏi ai_credit_creator_limits). So sánh với hạn mức Plan (subscription_plans.ai_credits_month) yêu cầu SUM(used_amount) qua TẤT CẢ Agency của cùng 1 Owner (user_subscriptions.user_id), không phải check riêng từng dòng ở đây.'] {
    id             uuid         [pk, default: `gen_random_uuid()`]
    agency_id      uuid         [not null, ref: > agencies.id]
    month          varchar(7)   [not null, note: 'YYYY-MM']
    used_amount    int          [not null, default: 0, note: 'tổng credit toàn Agency đã dùng trong tháng, cộng dồn từ mọi Creator']
    created_at     timestamptz  [not null, default: `now()`]
    updated_at     timestamptz  [not null, default: `now()`]

    indexes { (agency_id, month) [unique] }
  }

  Table ai_credit_creator_limits [note: 'PostgreSQL — Billing — NEW 2026-09-16 — cấu hình giới hạn credit RIÊNG từng Creator (FR 3.9.7), KHÔNG track usage — usage thật đọc từ ai_usage_logs (MongoDB, ai-service) filter theo creatorId'] {
    id             uuid         [pk, default: `gen_random_uuid()`]
    agency_id      uuid         [not null, ref: > agencies.id]
    creator_id     uuid         [not null, ref: > users.id, note: 'Creator bị áp giới hạn — không nullable, bảng này CHỈ chứa Creator có cap riêng']
    monthly_limit  int          [not null, note: 'set qua FR 3.9.7 bởi Owner — hạn mức riêng, nằm trong tổng ai_credit_ledgers của Agency, không cộng thêm']
    set_by         uuid         [not null, ref: > users.id, note: 'luôn là Owner theo BA 3.9.7']
    created_at     timestamptz  [not null, default: `now()`]
    updated_at     timestamptz  [not null, default: `now()`]

    indexes { (agency_id, creator_id) [unique] }
  }

  Table audit_logs [note: 'PostgreSQL — Billing — append-only, không đổi so với V1'] {
    id            bigserial    [pk]
    agency_id     uuid         [note: 'Soft ref intentional (giống user_id) — nullable cho ADMIN global actions, persist sau khi agency bị xoá']
    user_id       uuid         [not null, note: 'Soft ref intentional — persist sau khi user bị xoá']
    action        audit_action [not null]
    resource_type varchar(50)  [not null]
    resource_id   varchar(255)
    old_value     jsonb
    new_value     jsonb
    created_at    timestamptz  [not null, default: `now()`]

    indexes {
      (user_id, created_at)
      (agency_id, created_at)
      (resource_type, resource_id)
    }
  }

  // ============================================================
  // MONGODB — 10 COLLECTIONS
  // Note: soft refs tới PostgreSQL, filter workspaceId bắt buộc.
  // ============================================================

  Table tasks [note: 'MongoDB — NEW V2, thay posts — generic 3 loại (docs/database/database-strategy.md mục 4.4)'] {
    _id                     ObjectId          [pk]
    workspaceId             string            [not null, note: 'Soft ref → workspaces.id (PG)']
    sourceType              task_source_type  [not null]
    sourceRefId             string            [note: 'Soft ref → media_campaigns.id hoặc content_requests._id, tuỳ sourceType']
    type                    task_type         [not null]
    title                   string            [not null]
    description             string
    assigneeId              string            [note: 'Soft ref → users.id (PG)']
    qcAssigneeId            string            [note: 'Soft ref → users.id (PG) — tùy chọn']
    requiresClientApproval  boolean           [not null, default: false]
    status                  task_status       [not null, default: 'BACKLOG']
    currentContentVersionId string            [note: 'Soft ref → content_versions._id — bản nội dung MỚI NHẤT của Task loại post, tránh phải suy luận qua query content_versions mỗi lần đọc']
    typeMetadata            object            [note: 'field riêng theo type: platformTargets[] (post), livestreamSessionId (livestream, soft ref → livestream_sessions._id), surveyFormId (survey, soft ref → survey_forms._id)']
    dueDate                 date
    createdAt               date              [not null]
    updatedAt               date              [not null]

    indexes {
      (workspaceId, status)
      (workspaceId, assigneeId)
      (workspaceId, type)
    }
  }

  Table task_approvals [note: 'MongoDB — NEW V2 — tách khỏi tasks, GIỮ approval cũ khi step sau reject (docs/ba/13 mục 4)'] {
    _id       ObjectId              [pk]
    taskId    string                [not null, note: 'ref → tasks._id, cùng DB']
    step      task_approval_step    [not null]
    action    task_approval_action  [not null]
    actorId   string                [not null, note: 'Soft ref → users.id (PG)']
    comment   string
    createdAt date                  [not null]

    indexes { (taskId, step, createdAt) }
  }

  Table posts [note: 'MongoDB — ĐỔI NGHĨA V2 — chỉ bài ĐÃ PUBLISH thành công (kết quả Task type=post hoàn thành)'] {
    _id             ObjectId              [pk]
    workspaceId     string                [not null, note: 'Soft ref → workspaces.id (PG)']
    taskId          string                [not null, note: 'Soft ref → tasks._id — link về Task gốc']
    platform        social_platform       [not null]
    contentSubType  post_content_subtype  [not null, default: 'POST', note: 'FR 3.8.9-3.8.16 — Post/Story/Reels khác luồng publish hoàn toàn']
    socialAccountId string                [note: 'Soft ref → social_accounts._id']
    contentText     string                [not null]
    mediaUrls       string[]
    altText         string[]              [note: 'accessibility text song song mediaUrls — chuẩn Meta/IG API, yêu cầu pháp lý 1 số thị trường']
    firstComment    string                [note: 'bình luận đầu tiên tự động (hashtag dài) — chuẩn ngành Instagram/TikTok, giữ caption sạch']
    mentionedAccounts string[]            [note: 'tag brand/KOL hợp tác']
    location        string                [note: 'geotag — FR không nhắc trực tiếp nhưng chuẩn FB/IG post API, phổ biến bài F&B/sự kiện địa phương']
    videoDurationSeconds int              [note: 'validate giới hạn platform trước publish: Reels 90s, TikTok 600s, IG Story 15s/segment']
    videoAspectRatio string               [note: 'vd 9:16, 1:1, 16:9 — Reels/Story bắt buộc 9:16']
    status          post_publish_status   [not null, default: 'PENDING']
    errorCode       string                [note: 'lý do fail: rate_limit | token_expired | content_policy_violation | network_error...']
    retryCount      int                   [not null, default: 0]
    lastRetryAt     date
    scheduledAt     date
    publishedAt     date
    storyExpiresAt  date                  [note: 'Story tự hủy sau 24h trên FB/IG — null nếu contentSubType != STORY']
    externalPostId  string
    platformSpecificMeta object           [note: 'field riêng trả về theo platform: FB permalink_url, TikTok share_url+video_id, IG media_id+media_type']
    reactionCount   int                   [default: 0]
    commentCount    int                   [default: 0]
    shareCount      int                   [default: 0]
    comments        object[]              [note: 'FR 3.8.5 View Comment Detail List — {authorName, text, commentedAt, sentiment}, không chỉ đếm số']
    createdAt       date                  [not null]
    updatedAt       date                  [not null]

    indexes {
      (workspaceId, status)
      (workspaceId, scheduledAt)
    }
  }

  Table content_requests [note: 'MongoDB — ĐỔI FSM V2 — pending/in_progress/accepted/denied (denied=terminal), docs/ba/13 mục 5'] {
    _id                      ObjectId                [pk]
    workspaceId              string                  [not null, note: 'Soft ref → workspaces.id (PG)']
    createdByClientProfileId string                  [not null, note: 'Soft ref → client_profiles.id (PG) — CHỈ Client tạo']
    title                    string                  [not null]
    description              string
    targetPlatforms          social_platform[]       [note: 'nền tảng đăng tải dự kiến — FR 3.5.8 kế hoạch truyền thông cần rõ platform trước khi thảo luận với Client']
    proposedDate             date                    [note: 'khung thời gian mong muốn đăng, thảo luận trước khi accept thành Task']
    status                   content_request_status  [not null, default: 'PENDING']
    generatedTaskId          string                  [note: 'Soft ref → tasks._id — set khi status=ACCEPTED']
    createdAt                date                    [not null]
    updatedAt                date                    [not null]

    indexes { (workspaceId, status) }
  }

  Table material_repository [note: 'MongoDB — NEW V2 — kho ảnh/video raw vs retouched'] {
    _id          ObjectId    [pk]
    workspaceId  string      [not null, note: 'Soft ref → workspaces.id (PG)']
    taskId       string      [note: 'Soft ref → tasks._id, nullable nếu upload chung Workspace']
    fileUrl      string      [not null, note: 'S3 URL']
    fileType     string      [note: 'image | video']
    fileSize     int         [note: 'bytes — UI hiển thị + validate giới hạn upload']
    dimensions   object      [note: '{width, height} cho ảnh, {width, height, durationSeconds} cho video — validate tỷ lệ platform trước publish']
    isRetouched  boolean     [not null, default: false]
    usedInTaskIds string[]   [note: 'brand asset tái sử dụng nhiều Task — không chỉ 1 taskId lúc upload, cần biết mọi nơi đã dùng để cảnh báo raw-image']
    uploadedBy   string      [not null, note: 'Soft ref → users.id (PG)']
    createdAt    date        [not null]

    indexes { (workspaceId, taskId) }
  }

  Table brand_collections [note: 'MongoDB — NEW V2 — tài liệu Client cung cấp làm tham khảo'] {
    _id          ObjectId  [pk]
    workspaceId  string    [not null, note: 'Soft ref → workspaces.id (PG)']
    title        string    [not null]
    fileUrl      string
    description  string
    uploadedBy   string    [note: 'Soft ref → client_profiles.id hoặc users.id (PG)']
    createdAt    date      [not null]

    indexes { workspaceId }
  }

  Table hashtag_collections [note: 'MongoDB — NEW V2 — kho hashtag theo Workspace'] {
    _id          ObjectId  [pk]
    workspaceId  string    [not null, note: 'Soft ref → workspaces.id (PG)']
    name         string    [not null]
    hashtags     string[]  [not null]
    createdBy    string    [note: 'Soft ref → users.id (PG)']
    createdAt    date      [not null]
    updatedAt    date      [not null]

    indexes { workspaceId }
  }

  Table content_versions [note: 'MongoDB — NEW V2 — lịch sử version nội dung (Content History)'] {
    _id             ObjectId  [pk]
    taskId          string    [not null, note: 'ref → tasks._id']
    versionNumber   int       [not null]
    contentSnapshot object    [not null, note: 'snapshot nội dung tại thời điểm version']
    createdBy       string    [not null, note: 'Soft ref → users.id (PG)']
    createdAt       date      [not null]

    indexes { (taskId, versionNumber) }
  }

  Table livestream_sessions [note: 'MongoDB — NEW V2 — con của Task loại livestream, FR 3.6.22-3.6.24 (docs/BA/11 dòng 35)'] {
    _id           ObjectId              [pk]
    taskId        string                [not null, note: 'Soft ref → tasks._id']
    idea          string                [note: 'FR 3.6.22 Write Livestream Idea — ý tưởng + mục tiêu hướng tới']
    targetGoal    string
    script        string                [note: 'FR 3.6.23 Write Livestream Script — kịch bản đầy đủ']
    subStatus     livestream_sub_status [not null, default: 'PRE_LIVE', note: 'FR 3.6.24 Track Livestream Status']
    meetingLink   string                [note: 'FR 3.6.27 Generate Meeting Link — Google Meet tự động tạo']
    startedAt     date
    endedAt       date
    createdAt     date                  [not null]
    updatedAt     date                  [not null]

    indexes { taskId }
  }

  Table survey_forms [note: 'MongoDB — NEW V2 — con của Task loại survey, FR 3.6.25 (docs/BA/11 dòng 36)'] {
    _id           ObjectId  [pk]
    taskId        string    [not null, note: 'Soft ref → tasks._id']
    title         string    [not null]
    questions     object[]  [note: 'Form Creator — {questionText, questionType, options[], timeSlotStart, timeSlotEnd} theo BA mục 3 (time slot 0:10, 15:20...)']
    createdBy     string    [not null, note: 'Soft ref → users.id (PG)']
    createdAt     date      [not null]
    updatedAt     date      [not null]

    indexes { taskId }
  }

  Table survey_responses [note: 'MongoDB — NEW V2 — câu trả lời khảo sát, tách khỏi survey_forms vì high write throughput'] {
    _id           ObjectId  [pk]
    surveyFormId  string    [not null, note: 'ref → survey_forms._id, cùng DB']
    respondentId  string    [note: 'Soft ref → users.id hoặc client_profiles.id (PG), nullable nếu anonymous']
    answers       object[]  [not null, note: '{questionId, answerValue}']
    submittedAt   date      [not null]

    indexes { (surveyFormId, submittedAt) }
  }

  Table mail_templates [note: 'MongoDB — NEW V2 — FR 3.6.28-3.6.32, hoàn toàn thiếu ở thiết kế trước'] {
    _id           ObjectId          [pk]
    workspaceId   string            [not null, note: 'Soft ref → workspaces.id (PG)']
    name          string            [not null]
    subject       string            [not null]
    bodyHtml      string            [not null]
    type          mail_template_type [not null, default: 'CUSTOM', note: 'SYSTEM_DEFAULT = mẫu có sẵn, CUSTOM = user tự tạo hoặc clone từ default']
    createdBy     string            [note: 'Soft ref → users.id (PG)']
    createdAt     date              [not null]
    updatedAt     date              [not null]

    indexes { workspaceId }
  }

  Table social_accounts [note: 'MongoDB — giữ nguyên V1, bỏ ZALO_OA khỏi enum platform'] {
    _id              ObjectId              [pk]
    workspaceId      string                [not null, note: 'Soft ref → workspaces.id (PG)']
    clientProfileId  string                [note: 'Soft ref → client_profiles.id (PG)']
    platform         social_platform       [not null]
    accountName      string                [not null]
    accountId        string                [not null]
    encryptedToken   string                [not null]
    encryptedIv      string                [not null]
    tokenExpiresAt   date                  [not null]
    tokenStatus      social_account_status [not null, default: 'ACTIVE']
    permissions      string[]              [note: 'OAuth scope đã cấp, vd pages_manage_posts/instagram_content_publish — validate trước khi cho chọn platform lúc tạo Task']
    connectedBy      string                [note: 'Soft ref → users.id (PG) — audit trail ai connect tài khoản social nhạy cảm của Client']
    isActive         boolean               [not null, default: true]
    createdAt        date                  [not null]
    updatedAt        date                  [not null]

    indexes {
      workspaceId
      (workspaceId, platform, accountId) [unique]
    }
  }

  Table notifications [note: 'MongoDB — giữ nguyên V1, thêm type mới cho Package/Campaign/Task V2'] {
    _id         ObjectId          [pk]
    workspaceId string            [not null, note: 'Soft ref → workspaces.id (PG)']
    userId      string            [not null, note: 'Soft ref → users.id (PG)']
    type        notification_type [not null]
    title       string            [not null]
    body        string
    metadata    object
    isRead      boolean           [not null, default: false]
    createdAt   date              [not null]

    indexes {
      (userId, isRead)
      (workspaceId, userId)
      createdAt [note: 'TTL index — db.notifications.createIndex({createdAt:1},{expireAfterSeconds:2592000}), auto-expire 30 ngày']
    }
  }

  // ============================================================
  // MONGODB — ai-service
  // ============================================================

  Table ai_usage_logs [note: 'MongoDB (ai-service) — NEW 2026-09-16, trước đây chỉ nhắc tên không có field. Per-request credit consumption — nguồn thật để trả lời FR 3.9.5 View AI Credit Tracking (Creator xem mình dùng bao nhiêu, Owner giám sát toàn Agency). SUM(creditsUsed) filter theo creatorId/agencyId/month = usage thật 1 Creator hoặc toàn Agency trong tháng đó.'] {
    _id           ObjectId          [pk]
    agencyId      string            [not null, note: 'Soft ref → agencies.id (PG) — để SUM toàn Agency, đối chiếu ai_credit_ledgers.used_amount']
    workspaceId   string            [note: 'Soft ref → workspaces.id (PG), nullable nếu request không gắn Workspace cụ thể']
    creatorId     string            [not null, note: 'Soft ref → users.id (PG) — SUM theo field này = usage của 1 Creator, đối chiếu ai_credit_creator_limits.monthly_limit']
    feature       ai_usage_feature  [not null]
    creditsUsed   int               [not null]
    requestId     string            [note: 'trace về request AI gốc (log/debug), không unique bắt buộc']
    taskId        string            [note: 'Soft ref → tasks._id (Mongo, business-service), nullable nếu generate ngoài context 1 Task cụ thể']
    createdAt     date              [not null]

    indexes {
      (agencyId, createdAt)
      (creatorId, createdAt)
      (workspaceId, createdAt)
    }
  }

  // ============================================================
  // TABLE GROUPS
  // ============================================================

  TableGroup postgresql_identity {
    users
    user_oauth_providers
    user_refresh_tokens
    user_system_roles
  }

  TableGroup postgresql_organization {
    agencies
    agency_members
    agency_invitations
    workspaces
    workspace_members
    workspace_invitations
    workspace_templates
    client_profiles
  }

  TableGroup postgresql_commerce {
    media_packages
    workspace_media_packages
    media_campaigns
  }

  TableGroup postgresql_collaborator {
    third_party_collaborators
    campaign_collaborators
  }

  TableGroup postgresql_billing {
    subscription_plans
    user_subscriptions
    transactions
    ai_credit_ledgers
    ai_credit_creator_limits
    audit_logs
  }

  TableGroup mongodb_task_content {
    tasks
    task_approvals
    posts
    content_requests
    material_repository
    brand_collections
    hashtag_collections
    content_versions
    livestream_sessions
    survey_forms
    survey_responses
    mail_templates
  }

  TableGroup mongodb_business_other {
    social_accounts
    notifications
  }

  TableGroup mongodb_ai_service {
    ai_usage_logs
  }
