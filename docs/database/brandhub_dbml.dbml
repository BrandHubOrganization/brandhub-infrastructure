// BrandHub — Database Schema (DBML for dbdiagram.io)
// DA-E06-05 | Owner: Trung (Leader)
// PostgreSQL (11 tables): users, user_oauth_providers, user_refresh_tokens,
//                         workspaces, workspace_members, clients,
//                         subscription_plans, workspace_subscriptions,
//                         invoices, payments, audit_logs
// MongoDB (8 collections): social_accounts, posts, content_requests,
//                          knowledge_documents, notifications,
//                          publish_logs, ai_usage_logs, report_jobs

// ============================================================
// ENUMS
// ============================================================

Enum user_status {
  ACTIVE
  SUSPENDED
  DELETED
}

Enum oauth_provider {
  GOOGLE
  FACEBOOK
}

Enum member_role {
  OWNER
  MANAGER
  CREATOR
  VIEWER
}

Enum workspace_plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

Enum social_platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  THREADS
  ZALO_OA
}

Enum post_status {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

Enum notification_type {
  POST_APPROVED
  POST_REJECTED
  POST_FAILED
  POST_PUBLISHED
  REPORT_READY
  MEMBER_INVITED
  SUBSCRIPTION_EXPIRING
  CONTENT_REQUEST_ASSIGNED
}

Enum content_request_status {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  PENDING_REVIEW
  SENT_TO_CLIENT
  APPROVED
  REJECTED
  CANCELLED
}

Enum social_account_status {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  REVOKED
}

Enum publish_result {
  SUCCESS
  FAILED
  RETRYING
}

Enum report_job_status {
  PENDING
  RUNNING
  DONE
  FAILED
}

Enum subscription_status {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIALING
}

Enum invoice_status {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

Enum payment_status {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

Enum audit_action {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PERMISSION_CHANGE
}

// ============================================================
// POSTGRESQL — IDENTITY GROUP
// ============================================================

// Core identity. role + workspace_id removed — belong to workspace_members (3NF)
Table users [note: 'PostgreSQL — business-service | Identity only'] {
  id            uuid         [pk, default: `gen_random_uuid()`]
  email         varchar(255) [not null, unique]
  password_hash varchar      [note: 'null = OAuth-only user']
  full_name     varchar(255) [not null]
  avatar_url    varchar
  status        user_status  [not null, default: 'ACTIVE']
  is_active     boolean      [not null, default: true]
  preferences   jsonb        [not null, default: '{}', note: '{language, timezone, notifications}']
  last_login_at timestamptz
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]

  indexes {
    email [unique]
  }
}

// 1NF fix: extracted from users.oauth_providers[] array
Table user_oauth_providers [note: 'PostgreSQL — 1NF: extracted from users.oauth_providers[]'] {
  id          uuid           [pk, default: `gen_random_uuid()`]
  user_id     uuid           [not null, ref: > users.id]
  provider    oauth_provider [not null]
  provider_id varchar(255)   [not null]

  indexes {
    user_id
    (provider, provider_id) [unique]
  }
}

// 1NF fix: extracted from users.refresh_tokens[] array — includes device tracking
Table user_refresh_tokens [note: 'PostgreSQL — 1NF: extracted from users.refresh_tokens[]'] {
  id          uuid         [pk, default: `gen_random_uuid()`]
  user_id     uuid         [not null, ref: > users.id]
  token_hash  varchar(255) [not null, unique, note: 'Hashed — never store raw token']
  jti         varchar(255) [not null, unique]
  expires_at  timestamptz  [not null]
  ip_address  varchar(45)
  user_agent  varchar
  device_info jsonb        [not null, default: '{}', note: '{deviceType, osName, browserName}']
  created_at  timestamptz  [not null, default: `now()`]

  indexes {
    user_id
    jti [unique]
    expires_at
  }
}

// ADMIN is system-level — belongs to no workspace.
// OOP: discriminated type — user with a row here = SystemAdmin persona.
Table user_system_roles [note: 'PostgreSQL — ADMIN/SUPPORT: system-level, not workspace-scoped'] {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [not null, unique, ref: > users.id]
  system_role varchar(50) [not null, default: 'ADMIN', note: 'ADMIN | SUPPORT']
  granted_by  uuid        [ref: > users.id]
  granted_at  timestamptz [not null, default: `now()`]

  indexes {
    user_id [unique]
  }
}

// Audit trail for password reset. Runtime lookup = Redis (1h TTL); PG = permanent audit.
Table password_reset_tokens [note: 'PostgreSQL — Audit trail. Redis holds TTL copy for runtime.'] {
  id         uuid         [pk, default: `gen_random_uuid()`]
  user_id    uuid         [not null, ref: > users.id]
  token_hash varchar(255) [not null, unique]
  used_at    timestamptz  [note: 'null = unused / not yet consumed']
  ip_address varchar(45)
  expires_at timestamptz  [not null]
  created_at timestamptz  [not null, default: `now()`]

  indexes {
    user_id
    token_hash [unique]
  }
}

// ============================================================
// POSTGRESQL — WORKSPACE GROUP
// ============================================================

// Removed: plan (read from workspace_subscriptions), subscription_id (reverse lookup)
Table workspaces [note: 'PostgreSQL — business-service | Anchor for all FK chains'] {
  id         uuid        [pk, default: `gen_random_uuid()`]
  name       varchar(255) [not null]
  slug       varchar(100) [not null, unique]
  owner_id   uuid        [not null, ref: > users.id]
  logo_url   varchar
  settings   jsonb        [not null, default: '{}', note: '{brandColor, defaultLanguage, approvalRequired, timezone, defaultPlatforms, reportFrequency}']
  is_active  boolean      [not null, default: true]
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]

  indexes {
    slug [unique]
    owner_id
  }
}

// Junction: user ↔ workspace with role in that workspace
// role here = workspace role (OWNER/MANAGER/CREATOR/VIEWER), NOT system role
Table workspace_members [note: 'PostgreSQL — Junction: user ↔ workspace with workspace role'] {
  id           uuid        [pk, default: `gen_random_uuid()`]
  workspace_id uuid        [not null, ref: > workspaces.id]
  user_id      uuid        [not null, ref: > users.id]
  role         member_role  [not null]
  invited_by   uuid        [ref: > users.id]
  joined_at    timestamptz
  is_active    boolean      [not null, default: true, note: 'false = removed member (soft delete for audit)']
  created_at   timestamptz  [not null, default: `now()`]
  updated_at   timestamptz  [not null, default: `now()`]

  indexes {
    workspace_id
    user_id
    (workspace_id, user_id) [unique]
  }
}

// Invitation workflow. Sprint 6 E15-03: invited user may not exist yet.
// token = UUID sent in email link, consumed once on accept.
Table workspace_invitations [note: 'PostgreSQL — Pending invitations, consumed once on accept'] {
  id            uuid         [pk, default: `gen_random_uuid()`]
  workspace_id  uuid         [not null, ref: > workspaces.id]
  invited_email varchar(255) [not null]
  role          member_role  [not null]
  invited_by    uuid         [not null, ref: > users.id]
  token         varchar(255) [not null, unique, note: 'UUID in email link — single-use']
  status        varchar(20)  [not null, default: 'PENDING', note: 'PENDING|ACCEPTED|EXPIRED|REVOKED']
  expires_at    timestamptz  [not null]
  accepted_at   timestamptz
  accepted_by   uuid         [ref: > users.id]
  created_at    timestamptz  [not null, default: `now()`]

  indexes {
    workspace_id
    token [unique]
    invited_email
    (workspace_id, invited_email) [unique]
  }
}

// Fine-grained permission overrides per workspace member.
// Role = coarse; this table = explicit grant/deny overriding role defaults.
// e.g. CONTENT_CREATOR blocked from 'ai:image_gen' for a specific workspace.
Table workspace_member_permissions [note: 'PostgreSQL — Permission overrides per member'] {
  id                  uuid         [pk, default: `gen_random_uuid()`]
  workspace_member_id uuid         [not null, ref: > workspace_members.id]
  permission          varchar(100) [not null, note: 'ai:image_gen | post:publish | report:view | ...']
  granted             boolean      [not null, note: 'true=explicit allow, false=explicit deny']
  granted_by          uuid         [ref: > users.id]
  created_at          timestamptz  [not null, default: `now()`]

  indexes {
    workspace_member_id
    (workspace_member_id, permission) [unique]
  }
}

Table clients [note: 'PostgreSQL — business-service'] {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  workspace_id          uuid        [not null, ref: > workspaces.id]
  name                  varchar(255) [not null]
  brand_name            varchar(255)
  industry              varchar(100)
  logo_url              varchar
  contact_email         varchar(255)
  contact_phone         varchar(50)
  assigned_manager_id   uuid        [ref: > users.id]
  portal_access_enabled boolean      [not null, default: false]
  portal_user_id        uuid        [ref: > users.id, note: 'FK → users — BRAND_CLIENT role user']
  service_package       jsonb        [not null, default: '{}', note: '{postsPerMonth, platforms[], aiCreditsPerMonth}']
  metadata              jsonb        [not null, default: '{}', note: 'Flexible per agency']
  created_at            timestamptz  [not null, default: `now()`]
  updated_at            timestamptz  [not null, default: `now()`]

  indexes {
    workspace_id
    assigned_manager_id
  }
}

// ============================================================
// POSTGRESQL — BILLING GROUP
// ============================================================

Table subscription_plans [note: 'PostgreSQL — Master data, global'] {
  id               uuid           [pk, default: `gen_random_uuid()`]
  name             workspace_plan [not null, unique]
  display_name     varchar(100)   [not null]
  price_monthly    decimal(12,2)  [not null]
  price_yearly     decimal(12,2)  [not null]
  max_members      int            [not null]
  max_clients      int            [not null]
  max_posts_month  int            [not null, note: '-1 = unlimited']
  ai_credits_month int            [not null, note: '-1 = unlimited']
  features         jsonb          [not null, default: '[]', note: 'Array of feature flag strings']
  is_active        boolean        [not null, default: true]
  created_at       timestamptz    [not null, default: `now()`]
  updated_at       timestamptz    [not null, default: `now()`]
}

// workspace_id is now a real FK (not soft ref) since workspaces moved to PG
Table workspace_subscriptions [note: 'PostgreSQL — Billing state per workspace'] {
  id                   uuid                [pk, default: `gen_random_uuid()`]
  workspace_id         uuid                [not null, unique, ref: > workspaces.id]
  plan_id              uuid                [not null, ref: > subscription_plans.id]
  status               subscription_status [not null, default: 'TRIALING']
  trial_ends_at        timestamptz
  current_period_start timestamptz         [not null]
  current_period_end   timestamptz         [not null]
  cancelled_at         timestamptz
  cancel_reason        varchar
  created_at           timestamptz         [not null, default: `now()`]
  updated_at           timestamptz         [not null, default: `now()`]

  indexes {
    workspace_id [unique]
    (status, current_period_end)
  }
}

Table invoices [note: 'PostgreSQL — Immutable after status = ISSUED'] {
  id              uuid           [pk, default: `gen_random_uuid()`]
  workspace_id    uuid           [not null, ref: > workspaces.id]
  subscription_id uuid           [not null, ref: > workspace_subscriptions.id]
  invoice_number  varchar(50)    [not null, unique]
  status          invoice_status [not null, default: 'DRAFT']
  amount          decimal(12,2)  [not null]
  currency        varchar(3)     [not null, default: 'VND']
  period_start    timestamptz    [not null]
  period_end      timestamptz    [not null]
  issued_at       timestamptz
  due_at          timestamptz
  paid_at         timestamptz
  created_at      timestamptz    [not null, default: `now()`]
  updated_at      timestamptz    [not null, default: `now()`]

  indexes {
    workspace_id
    subscription_id
    invoice_number [unique]
  }
}

Table payments [note: 'PostgreSQL — Atomic, no duplicate allowed'] {
  id             uuid           [pk, default: `gen_random_uuid()`]
  workspace_id   uuid           [not null, ref: > workspaces.id]
  invoice_id     uuid           [not null, ref: > invoices.id]
  amount         decimal(12,2)  [not null]
  currency       varchar(3)     [not null, default: 'VND']
  status         payment_status [not null, default: 'PENDING']
  payment_method varchar(50)    [note: 'bank_transfer | momo | vnpay | stripe']
  transaction_id varchar(255)   [unique, note: 'External payment gateway TX ID']
  paid_at        timestamptz
  failed_reason  varchar
  created_at     timestamptz    [not null, default: `now()`]
  updated_at     timestamptz    [not null, default: `now()`]

  indexes {
    workspace_id
    invoice_id
    transaction_id [unique]
  }
}

// Append-only. user_id = soft ref intentionally:
// user may be deleted but audit log must persist (compliance)
Table audit_logs [note: 'PostgreSQL — Append-only, no UPDATE/DELETE ever'] {
  id            bigserial    [pk]
  workspace_id  uuid         [note: 'Nullable — ADMIN global actions have no workspace']
  user_id       uuid         [not null, note: 'Soft ref — kept even if user deleted']
  action        audit_action [not null]
  resource_type varchar(50)  [not null, note: 'User | Post | Workspace | Client | ...']
  resource_id   varchar(255) [note: 'ID of affected entity']
  old_value     jsonb        [note: 'State before change']
  new_value     jsonb        [note: 'State after change']
  ip_address    varchar(45)
  user_agent    varchar
  created_at    timestamptz  [not null, default: `now()`]

  indexes {
    (user_id, created_at)
    (workspace_id, created_at)
    (resource_type, resource_id)
  }
}

// ============================================================
// MONGODB COLLECTIONS
// ============================================================

// workspace_id, client_id = soft refs → PostgreSQL UUIDs stored as strings
Table social_accounts [note: 'MongoDB — business-service'] {
  _id                     varchar               [pk, note: 'ObjectId']
  workspace_id            varchar               [not null, note: 'soft ref → workspaces.id (PG)']
  client_id               varchar               [note: 'soft ref → clients.id (PG)']
  platform                social_platform       [not null]
  account_name            varchar               [not null]
  account_id              varchar               [not null, note: 'Platform page/user ID']
  encrypted_token         varchar               [not null, note: 'AES-256-GCM encrypted access token']
  encrypted_iv            varchar               [not null, note: 'AES-256-GCM IV for access token']
  encrypted_refresh_token varchar               [note: 'AES-256-GCM encrypted refresh token']
  encrypted_refresh_iv    varchar               [note: 'AES-256-GCM IV for refresh token']
  token_expires_at        timestamp             [not null]
  token_status            social_account_status [not null, default: 'ACTIVE']
  scopes                  varchar               [note: 'Array<string>']
  is_active               boolean               [not null, default: true]
  created_at              timestamp             [not null]
  updated_at              timestamp             [not null]

  indexes {
    workspace_id
    (workspace_id, platform, account_id) [unique]
    (workspace_id, token_status)
  }
}

Table posts [note: 'MongoDB — business-service | High write, schema flexible per platform'] {
  _id                varchar         [pk, note: 'ObjectId']
  workspace_id       varchar         [not null, note: 'soft ref → workspaces.id (PG)']
  client_id          varchar         [note: 'soft ref → clients.id (PG)']
  created_by         varchar         [not null, note: 'soft ref → users.id (PG)']
  title              varchar
  content_text       varchar         [not null]
  media_urls         varchar         [note: 'Array<string> — S3 URLs']
  platform           social_platform [not null]
  social_account_id  varchar         [note: 'soft ref → social_accounts._id']
  status             post_status     [not null, default: 'DRAFT']
  scheduled_at       timestamp
  published_at       timestamp
  external_post_id   varchar         [note: 'Platform post ID after publish']
  ai_generated       boolean         [not null, default: false]
  ai_metadata        varchar         [note: 'Object: {model, prompt, tokensUsed}']
  approval_history   varchar         [note: 'Array<{userId, action, comment, at}>']
  content_request_id varchar         [note: 'soft ref → content_requests._id']
  created_at         timestamp       [not null]
  updated_at         timestamp       [not null]

  indexes {
    (workspace_id, status)
    (workspace_id, scheduled_at)
    (workspace_id, client_id)
  }
}

Table content_requests [note: 'MongoDB — business-service | 8-state workflow'] {
  _id            varchar                [pk, note: 'ObjectId']
  workspace_id   varchar                [not null, note: 'soft ref → workspaces.id (PG)']
  client_id      varchar                [note: 'soft ref → clients.id (PG)']
  requested_by   varchar                [not null, note: 'soft ref → users.id (PG)']
  assigned_to    varchar                [note: 'soft ref → users.id (PG) — CONTENT_CREATOR']
  title          varchar                [not null]
  description    varchar
  tone           varchar                [note: 'professional | casual | humorous | inspirational']
  platforms      varchar                [note: 'Array<social_platform>']
  deadline       timestamp
  status         content_request_status [not null, default: 'SUBMITTED']
  linked_post_id varchar                [note: 'soft ref → posts._id']
  attachments    varchar                [note: 'Array<string> — S3 URLs']
  comments       varchar                [note: 'Array<{userId, text, at}>']
  created_at     timestamp              [not null]
  updated_at     timestamp              [not null]

  indexes {
    (workspace_id, status)
    (workspace_id, client_id)
    (workspace_id, assigned_to)
  }
}

Table knowledge_documents [note: 'MongoDB — ai-service | RAG source documents'] {
  _id          varchar   [pk, note: 'ObjectId']
  workspace_id varchar   [not null, note: 'soft ref → workspaces.id (PG)']
  client_id    varchar   [note: 'soft ref → clients.id (PG)']
  title        varchar   [not null]
  content      varchar   [not null, note: 'Raw text — also chunked & indexed in ChromaDB']
  source_url   varchar
  file_type    varchar   [note: 'pdf | docx | txt | url']
  chunk_ids    varchar   [note: 'Array<string> — ChromaDB chunk IDs']
  tags         varchar   [note: 'Array<string>']
  created_by   varchar   [note: 'soft ref → users.id (PG)']
  created_at   timestamp [not null]
  updated_at   timestamp [not null]

  indexes {
    workspace_id
    (workspace_id, client_id)
  }
}

Table notifications [note: 'MongoDB — business-service | TTL 30d auto-expire'] {
  _id          varchar           [pk, note: 'ObjectId']
  workspace_id varchar           [not null, note: 'soft ref → workspaces.id (PG)']
  user_id      varchar           [not null, note: 'soft ref → users.id (PG)']
  type         notification_type [not null]
  title        varchar           [not null]
  body         varchar
  metadata     varchar           [note: 'Object: {postId, clientId, etc}']
  is_read      boolean           [not null, default: false]
  created_at   timestamp         [not null, note: 'TTL index: expire after 30d']

  indexes {
    (user_id, is_read)
    (workspace_id, user_id)
  }
}

Table publish_logs [note: 'MongoDB — publisher-service | Append-only, high write'] {
  _id               varchar         [pk, note: 'ObjectId']
  workspace_id      varchar         [not null, note: 'soft ref → workspaces.id (PG)']
  post_id           varchar         [not null, note: 'soft ref → posts._id']
  platform          social_platform [not null]
  social_account_id varchar
  result            publish_result  [not null]
  external_post_id  varchar
  error_message     varchar
  retry_count       int             [not null, default: 0]
  published_at      timestamp
  created_at        timestamp       [not null]

  indexes {
    post_id
    (workspace_id, result)
  }
}

Table ai_usage_logs [note: 'MongoDB — ai-service | Append-only, schema flexible per model'] {
  _id           varchar   [pk, note: 'ObjectId']
  workspace_id  varchar   [not null, note: 'soft ref → workspaces.id (PG)']
  user_id       varchar   [note: 'soft ref → users.id (PG)']
  feature       varchar   [not null, note: 'content_gen | image_gen | video_gen | rag | ambassador']
  model         varchar   [not null, note: 'llama3 | claude | sdxl | veo | instantid']
  input_tokens  int
  output_tokens int
  cost_usd      float
  latency_ms    int
  success       boolean   [not null]
  error_code    varchar
  created_at    timestamp [not null]

  indexes {
    (workspace_id, feature)
    created_at
  }
}

Table report_jobs [note: 'MongoDB — business-service | Background job state'] {
  _id           varchar           [pk, note: 'ObjectId']
  workspace_id  varchar           [not null, note: 'soft ref → workspaces.id (PG)']
  client_id     varchar           [note: 'soft ref → clients.id (PG)']
  requested_by  varchar           [not null, note: 'soft ref → users.id (PG)']
  status        report_job_status [not null, default: 'PENDING']
  date_from     timestamp         [not null]
  date_to       timestamp         [not null]
  file_url      varchar           [note: 'S3 URL — populated when status = DONE']
  error_message varchar
  created_at    timestamp         [not null]
  updated_at    timestamp         [not null]

  indexes {
    (workspace_id, status)
    (workspace_id, client_id)
  }
}

// ============================================================
// TABLE GROUPS
// ============================================================

TableGroup postgresql_identity {
  users
  user_oauth_providers
  user_refresh_tokens
  user_system_roles
  password_reset_tokens
}

TableGroup postgresql_workspace {
  workspaces
  workspace_members
  workspace_invitations
  workspace_member_permissions
  clients
}

TableGroup postgresql_billing {
  subscription_plans
  workspace_subscriptions
  invoices
  payments
  audit_logs
}

TableGroup mongodb_business {
  social_accounts
  posts
  content_requests
  notifications
  report_jobs
}

TableGroup mongodb_ai {
  knowledge_documents
  ai_usage_logs
}

TableGroup mongodb_publisher {
  publish_logs
}
