@startuml BrandHub ERD
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

skinparam entity {
  BackgroundColor #FAFAFA
  BorderColor #555555
  FontSize 12
}

' ============================================================
' POSTGRESQL — IDENTITY GROUP
' ============================================================

entity "users" as users <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * email : varchar(255) <<UQ>>
  password_hash : varchar
  * full_name : varchar(255)
  avatar_url : varchar
  * status : user_status
  * is_active : boolean
  * preferences : jsonb
  last_login_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "user_oauth_providers" as oauth <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * provider : oauth_provider
  * provider_id : varchar(255)
}

entity "user_refresh_tokens" as refresh_tokens <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * token_hash : varchar(255) <<UQ>>
  * jti : varchar(255) <<UQ>>
  * expires_at : timestamptz
  ip_address : varchar(45)
  user_agent : varchar
  * device_info : jsonb
  * created_at : timestamptz
}

entity "user_system_roles" as system_roles <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK, UQ>>
  * system_role : varchar(50)
  granted_by : uuid <<FK>>
  * granted_at : timestamptz
}

entity "password_reset_tokens" as pwd_reset <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * token_hash : varchar(255) <<UQ>>
  used_at : timestamptz
  ip_address : varchar(45)
  * expires_at : timestamptz
  * created_at : timestamptz
}

' ============================================================
' POSTGRESQL — WORKSPACE GROUP
' ============================================================

entity "workspaces" as workspaces <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * name : varchar(255)
  * slug : varchar(100) <<UQ>>
  * owner_id : uuid <<FK>>
  logo_url : varchar
  * settings : jsonb
  * is_active : boolean
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "workspace_members" as wm <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * workspace_id : uuid <<FK>>
  * user_id : uuid <<FK>>
  * role : member_role
  invited_by : uuid <<FK>>
  joined_at : timestamptz
  * is_active : boolean
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "workspace_invitations" as invitations <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * workspace_id : uuid <<FK>>
  * invited_email : varchar(255)
  * role : member_role
  * invited_by : uuid <<FK>>
  * token : varchar(255) <<UQ>>
  * status : varchar(20)
  * expires_at : timestamptz
  accepted_at : timestamptz
  accepted_by : uuid <<FK>>
  * created_at : timestamptz
}

entity "workspace_member_permissions" as perms <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * workspace_member_id : uuid <<FK>>
  * permission : varchar(100)
  * granted : boolean
  granted_by : uuid <<FK>>
  * created_at : timestamptz
}

entity "clients" as clients <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * workspace_id : uuid <<FK>>
  * name : varchar(255)
  brand_name : varchar(255)
  industry : varchar(100)
  logo_url : varchar
  contact_email : varchar(255)
  contact_phone : varchar(50)
  assigned_manager_id : uuid <<FK>>
  * portal_access_enabled : boolean
  portal_user_id : uuid <<FK>>
  * service_package : jsonb
  * metadata : jsonb
  * created_at : timestamptz
  * updated_at : timestamptz
}

' ============================================================
' POSTGRESQL — BILLING GROUP
' ============================================================

entity "subscription_plans" as plans <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * name : workspace_plan <<UQ>>
  * display_name : varchar(100)
  * price_monthly : decimal(12,2)
  * price_yearly : decimal(12,2)
  * max_members : int
  * max_clients : int
  * max_posts_month : int
  * ai_credits_month : int
  * features : jsonb
  * is_active : boolean
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "workspace_subscriptions" as subscriptions <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * workspace_id : uuid <<FK, UQ>>
  * plan_id : uuid <<FK>>
  * status : subscription_status
  trial_ends_at : timestamptz
  * current_period_start : timestamptz
  * current_period_end : timestamptz
  cancelled_at : timestamptz
  cancel_reason : varchar
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "invoices" as invoices <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * workspace_id : uuid <<FK>>
  * subscription_id : uuid <<FK>>
  * invoice_number : varchar(50) <<UQ>>
  * status : invoice_status
  * amount : decimal(12,2)
  * currency : varchar(3)
  * period_start : timestamptz
  * period_end : timestamptz
  issued_at : timestamptz
  due_at : timestamptz
  paid_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "payments" as payments <<PostgreSQL>> {
  * id : uuid <<PK>>
  --
  * workspace_id : uuid <<FK>>
  * invoice_id : uuid <<FK>>
  * amount : decimal(12,2)
  * currency : varchar(3)
  * status : payment_status
  payment_method : varchar(50)
  transaction_id : varchar(255) <<UQ>>
  paid_at : timestamptz
  failed_reason : varchar
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "audit_logs" as audit <<PostgreSQL>> {
  * id : bigserial <<PK>>
  --
  workspace_id : uuid
  * user_id : uuid
  * action : audit_action
  * resource_type : varchar(50)
  resource_id : varchar(255)
  old_value : jsonb
  new_value : jsonb
  ip_address : varchar(45)
  user_agent : varchar
  * created_at : timestamptz
}

' ============================================================
' MONGODB COLLECTIONS
' ============================================================

entity "social_accounts" as social <<MongoDB>> {
  * _id : ObjectId <<PK>>
  --
  * workspaceId : string <<soft ref PG>>
  clientId : string <<soft ref PG>>
  * platform : social_platform
  * accountName : string
  * accountId : string
  * encryptedToken : string
  * encryptedIv : string
  encryptedRefreshToken : string
  encryptedRefreshIv : string
  * tokenExpiresAt : date
  * tokenStatus : social_account_status
  scopes : string[]
  * isActive : boolean
  * createdAt : date
  * updatedAt : date
}

entity "posts" as posts <<MongoDB>> {
  * _id : ObjectId <<PK>>
  --
  * workspaceId : string <<soft ref PG>>
  clientId : string <<soft ref PG>>
  * createdBy : string <<soft ref PG>>
  title : string
  * contentText : string
  mediaUrls : string[]
  * platform : social_platform
  socialAccountId : string
  * status : post_status
  scheduledAt : date
  publishedAt : date
  externalPostId : string
  * aiGenerated : boolean
  aiMetadata : object
  approvalHistory : object[]
  contentRequestId : string
  * createdAt : date
  * updatedAt : date
}

entity "content_requests" as cr <<MongoDB>> {
  * _id : ObjectId <<PK>>
  --
  * workspaceId : string <<soft ref PG>>
  clientId : string <<soft ref PG>>
  * requestedBy : string <<soft ref PG>>
  assignedTo : string <<soft ref PG>>
  * title : string
  description : string
  tone : string
  platforms : string[]
  deadline : date
  * status : content_request_status
  linkedPostId : string
  attachments : string[]
  comments : object[]
  * createdAt : date
  * updatedAt : date
}

entity "knowledge_documents" as kdocs <<MongoDB>> {
  * _id : ObjectId <<PK>>
  --
  * workspaceId : string <<soft ref PG>>
  clientId : string <<soft ref PG>>
  * title : string
  * content : string
  sourceUrl : string
  fileType : string
  chunkIds : string[]
  tags : string[]
  createdBy : string
  * createdAt : date
  * updatedAt : date
}

entity "notifications" as notifs <<MongoDB>> {
  * _id : ObjectId <<PK>>
  --
  * workspaceId : string <<soft ref PG>>
  * userId : string <<soft ref PG>>
  * type : notification_type
  * title : string
  body : string
  metadata : object
  * isRead : boolean
  * createdAt : date <<TTL 30d>>
}

entity "publish_logs" as pub_logs <<MongoDB>> {
  * _id : ObjectId <<PK>>
  --
  * workspaceId : string <<soft ref PG>>
  * postId : string <<soft ref>>
  * platform : social_platform
  socialAccountId : string
  * result : publish_result
  externalPostId : string
  errorMessage : string
  * retryCount : int
  publishedAt : date
  * createdAt : date
}

entity "ai_usage_logs" as ai_logs <<MongoDB>> {
  * _id : ObjectId <<PK>>
  --
  * workspaceId : string <<soft ref PG>>
  userId : string <<soft ref PG>>
  * feature : string
  * model : string
  inputTokens : int
  outputTokens : int
  costUsd : float
  latencyMs : int
  * success : boolean
  errorCode : string
  * createdAt : date
}

entity "report_jobs" as report_jobs <<MongoDB>> {
  * _id : ObjectId <<PK>>
  --
  * workspaceId : string <<soft ref PG>>
  clientId : string <<soft ref PG>>
  * requestedBy : string <<soft ref PG>>
  * status : report_job_status
  * dateFrom : date
  * dateTo : date
  fileUrl : string
  errorMessage : string
  * createdAt : date
  * updatedAt : date
}

' ============================================================
' RELATIONSHIPS — PostgreSQL
' ============================================================
' Rule: only 1 line per table pair to avoid crossing arrows.
' Secondary FKs (invited_by, accepted_by, granted_by, portal_user, manager)
' are annotated as <<FK>> inside the entity body — not drawn as lines.

' Identity chain — all radiate out from users
users           ||--o{ oauth            : " "
users           ||--o{ refresh_tokens   : " "
users           ||--o| system_roles     : " "
users           ||--o{ pwd_reset        : " "

' Workspace hub — workspaces connects to everything in workspace group
workspaces      }o--||  users           : "owner"
workspaces      ||--o{ wm               : " "
workspaces      ||--o{ invitations      : " "
workspaces      ||--|{ clients          : " "
workspaces      ||--||  subscriptions   : " "
workspaces      ||--o{ invoices         : " "
workspaces      ||--o{ payments         : " "

' workspace_members chains
wm              }o--||  users           : "member"
wm              ||--o{ perms            : " "

' Billing chain
subscriptions   }o--||  plans           : " "
invoices        }o--||  subscriptions   : " "
payments        }o--||  invoices        : " "

@enduml
