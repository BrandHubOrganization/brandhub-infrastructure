          },
          "name": "Ch\u00e0o m\u1eebng Client m\u1edbi",
          "subject": "Ch\u00e0o m\u1eebng {{name}} \u0111\u1ebfn v\u1edbi {{workspaceName}}",
          "bodyHtml": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f5;padding:24px 12px\"><tbody><tr><td align=\"center\"><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border-top:4px solid #f05a28;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b\"><tbody><tr><td style=\"height:12px;line-height:12px;font-size:1px\">&nbsp;</td></tr><tr><td class=\"mail-block mail-block-header\" style=\"padding:12px 32px 4px\"><div style=\"font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#f05a28\">{{workspaceName}}</div></td></tr><tr><td class=\"mail-block mail-block-paragraph\" style=\"padding:10px 32px\"><p style=\"margin:0;font-size:15px;line-height:1.65;color:#3f3f46;white-space:pre-wrap\">Xin ch\u00e0o {{name}},</p></td></tr><tr><td class=\"mail-block mail-block-paragraph\" style=\"padding:10px 32px\"><p style=\"margin:0;font-size:15px;line-height:1.65;color:#3f3f46;white-space:pre-wrap\">C\u1ea3m \u01a1n b\u1ea1n \u0111\u00e3 l\u1ef1a ch\u1ecdn {{workspaceName}}. Ch\u00fang t\u00f4i r\u1ea5t vui \u0111\u01b0\u1ee3c \u0111\u1ed3ng h\u00e0nh c\u00f9ng b\u1ea1n.</p></td></tr><tr><td class=\"mail-block mail-block-paragraph\" style=\"padding:10px 32px\"><p style=\"margin:0;font-size:15px;line-height:1.65;color:#3f3f46;white-space:pre-wrap\">Trong th\u1eddi gian t\u1edbi, ch\u00fang t\u00f4i s\u1ebd trao \u0111\u1ed5i v\u1ec1 m\u1ee5c ti\u00eau, k\u00eanh truy\u1ec1n th\u00f4ng v\u00e0 l\u1ecbch tri\u1ec3n khai n\u1ed9i dung.</p></td></tr><tr><td class=\"mail-block mail-block-paragraph\" style=\"padding:10px 32px\"><p style=\"margin:0;font-size:15px;line-height:1.65;color:#3f3f46;white-space:pre-wrap\">Tr\u00e2n tr\u1ecdng,\n{{senderName}}</p></td></tr><tr><td class=\"mail-block mail-block-footer\" style=\"padding:10px 32px\"><div style=\"padding-top:8px;font-size:12px;line-height:1.6;color:#71717a;text-align:center\">Email \u0111\u01b0\u1ee3c g\u1eedi t\u1eeb {{workspaceName}} qua BrandHub.</div></td></tr><tr><td style=\"height:12px;line-height:12px;font-size:1px\">&nbsp;</td></tr></tbody></table></td></tr></tbody></table>",
          "type": "SYSTEM_DEFAULT",
          "scope": "ADMIN_SYSTEM_BROADCAST",
          "layoutJson": "{\"version\": 1, \"locale\": \"vi\", \"blocks\": [{\"type\": \"header\", \"props\": {}, \"id\": \"b1\"}, {\"type\": \"paragraph\", \"props\": {\"text\": \"Xin ch\u00e0o {{name}},\"}, \"id\": \"b2\"}, {\"type\": \"paragraph\", \"props\": {\"text\": \"C\u1ea3m \u01a1n b\u1ea1n \u0111\u00e3 l\u1ef1a ch\u1ecdn {{workspaceName}}. Ch\u00fang t\u00f4i r\u1ea5t vui \u0111\u01b0\u1ee3c \u0111\u1ed3ng h\u00e0nh c\u00f9ng b\u1ea1n.\"}, \"id\": \"b3\"}, {\"type\": \"paragraph\", \"props\": {\"text\": \"Trong th\u1eddi gian t\u1edbi, ch\u00fang t\u00f4i s\u1ebd trao \u0111\u1ed5i v\u1ec1 m\u1ee5c ti\u00eau, k\u00eanh truy\u1ec1n th\u00f4ng v\u00e0 l\u1ecbch tri\u1ec3n khai n\u1ed9i dung.\"}, \"id\": \"b4\"}, {\"type\": \"paragraph\", \"props\": {\"text\": \"Tr\u00e2n tr\u1ecdng,\\n{{senderName}}\"}, \"id\": \"b5\"}, {\"type\": \"footer\", \"props\": {}, \"id\": \"b6\"}]}",
          "attachments": [],
