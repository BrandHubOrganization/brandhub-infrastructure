    "chat_scheduled_messages": {
      "options": {
        "validator": {
          "$and": [
            {
              "$jsonSchema": {
                "bsonType": "object",
                "required": [
                  "workspaceId",
                  "channelId",
                  "senderUserId",
                  "clientMessageId",
                  "requestHash",
                  "deliveryMessageId",
                  "content",
                  "mentionUserIds",
                  "contextType",
                  "scheduledAt",
                  "timeZone",
                  "status",
                  "revision",
                  "attempts",
                  "availableAt",
                  "createdAt",
                  "updatedAt"
                ],
                "properties": {
                  "_id": {
                    "bsonType": "objectId"
                  },
                  "workspaceId": {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "senderUserId": {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "channelId": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "clientMessageId": {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "deliveryMessageId": {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "requestHash": {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "content": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "richContent": {
                    "bsonType": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "doc"
                        ]
                      },
                      "content": {
                        "bsonType": "array",
                        "maxItems": 500
                      }
                    }
                  },
                  "mentionUserIds": {
                    "bsonType": "array",
                    "uniqueItems": true,
                    "maxItems": 20,
                    "items": {
                      "bsonType": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    }
                  },
                  "contextType": {
                    "enum": [
                      "GENERAL",
                      "MEDIA_PACKAGE",
                      "MEDIA_CAMPAIGN"
                    ]
                  },
                  "contextId": {
                    "bsonType": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "threadRootId": {
                    "bsonType": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{24}$"
                  },
                  "scheduledAt": {
                    "bsonType": "date"
                  },
                  "availableAt": {
                    "bsonType": "date"
                  },
                  "timeZone": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "status": {
                    "enum": [
                      "PENDING",
                      "SENDING",
                      "SENT",
                      "FAILED",
                      "CANCELLED"
                    ]
                  },
                  "revision": {
                    "bsonType": [
                      "int",
                      "long"
                    ],
                    "minimum": 0
                  },
                  "attempts": {
                    "bsonType": [
                      "int",
                      "long"
                    ],
                    "minimum": 0
                  },
                  "leaseOwner": {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "leaseUntil": {
                    "bsonType": "date"
                  },
                  "createdAt": {
                    "bsonType": "date"
                  },
                  "updatedAt": {
                    "bsonType": "date"
                  },
                  "sentAt": {
                    "bsonType": "date"
                  },
                  "cancelledAt": {
                    "bsonType": "date"
                  },
                  "sentMessageId": {
                    "bsonType": "string",
                    "pattern": "^[0-9a-f]{24}$"
                  },
                  "errorCode": {
                    "bsonType": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "broadcastPending": {
                    "bsonType": "bool"
                  }
                }
              }
            },
            {
              "$or": [
                {
                  "status": "SENDING",
                  "leaseOwner": {
                    "$type": "string"
                  },
                  "leaseUntil": {
                    "$type": "date"
                  }
                },
                {
                  "status": "PENDING",
                  "leaseOwner": {
                    "$exists": false
                  },
                  "leaseUntil": {
                    "$exists": false
                  }
                },
                {
                  "status": "FAILED",
                  "errorCode": {
                    "$type": "string"
                  },
                  "leaseOwner": {
                    "$exists": false
                  },
                  "leaseUntil": {
                    "$exists": false
                  }
                },
                {
                  "status": "CANCELLED",
                  "cancelledAt": {
                    "$type": "date"
                  },
                  "leaseOwner": {
                    "$exists": false
                  },
                  "leaseUntil": {
                    "$exists": false
                  }
                },
                {
                  "status": "SENT",
                  "sentAt": {
                    "$type": "date"
                  },
                  "sentMessageId": {
                    "$type": "string"
                  },
                  "leaseOwner": {
                    "$exists": false
                  },
                  "leaseUntil": {
                    "$exists": false
                  }
                }
              ]
            }
          ]
        },
        "validationLevel": "strict",
        "validationAction": "error"
      },
      "indexes": [
        {
          "v": 2,
          "key": {
            "_id": 1
          },
          "name": "_id_"
        },
        {
          "v": 2,
          "key": {
            "workspaceId": 1,
            "senderUserId": 1,
            "clientMessageId": 1
          },
          "name": "uq_chat_schedule_request",
          "unique": true
        },
        {
          "v": 2,
          "key": {
            "workspaceId": 1,
            "senderUserId": 1,
            "scheduledAt": 1,
            "_id": 1
          },
          "name": "idx_chat_schedule_own"
        },
        {
          "v": 2,
          "key": {
            "status": 1,
            "availableAt": 1,
            "_id": 1
          },
          "name": "idx_chat_schedule_due"
        },
        {
          "v": 2,
          "key": {
            "status": 1,
            "leaseUntil": 1
          },
          "name": "idx_chat_schedule_lease"
        },
        {
          "v": 2,
          "key": {
            "status": 1,
            "broadcastPending": 1,
            "updatedAt": 1,
            "_id": 1
          },
          "name": "idx_chat_schedule_broadcast"
        }
      ],
