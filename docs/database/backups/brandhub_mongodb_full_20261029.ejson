                  "string",
                  "null"
                ]
              },
              "leaseUntil": {
                "bsonType": [
                  "date",
                  "null"
                ]
              },
              "deliveredAt": {
                "bsonType": [
                  "date",
                  "null"
                ]
              }
            }
          }
