    "chat_notification_preferences": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "_id",
              "workspaceId",
              "userId"
            ],
            "properties": {
              "_id": {
                "bsonType": "string"
              },
              "workspaceId": {
                "bsonType": "string"
              },
              "userId": {
                "bsonType": "string"
              },
              "dnd": {
                "bsonType": "bool"
              },
              "mutedChannelIds": {
                "bsonType": "array",
                "uniqueItems": true,
                "items": {
                  "bsonType": "string"
                }
              }
            }
          }
        },
        "validationLevel": "strict",
        "validationAction": "error"
      },
      "indexes": [
        {
          "v": 2,
          "key": {
            "_id": 1
          },
          "name": "_id_"
        },
        {
          "v": 2,
          "key": {
            "workspaceId": 1,
            "userId": 1
          },
          "name": "uq_chat_notification_preferences_user",
          "unique": true
        }
      ],
      "documents": []
    },
