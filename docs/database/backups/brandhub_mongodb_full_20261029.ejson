    "chat_calls": {
      "options": {
        "validator": {
          "$and": [
            {
              "$jsonSchema": {
                "bsonType": "object",
                "required": [
                  "_id",
                  "workspaceId",
                  "channelId",
                  "callerId",
                  "calleeId",
                  "participantIds",
                  "state",
                  "revision",
                  "createdAt",
                  "updatedAt",
                  "expiresAt"
                ],
                "additionalProperties": false,
                "properties": {
                  "_id": {
                    "bsonType": "string"
                  },
                  "_class": {
                    "bsonType": "string"
                  },
                  "workspaceId": {
                    "bsonType": "string"
                  },
                  "channelId": {
                    "bsonType": "string"
                  },
                  "callerId": {
                    "bsonType": "string"
                  },
                  "calleeId": {
                    "bsonType": "string"
                  },
                  "participantIds": {
                    "bsonType": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "bsonType": "string"
                    }
                  },
                  "activeParticipantIds": {
                    "bsonType": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "bsonType": "string"
                    }
                  },
                  "state": {
                    "enum": [
                      "RINGING",
                      "CONNECTING",
                      "ACTIVE",
                      "DECLINED",
                      "CANCELLED",
                      "MISSED",
                      "ENDED",
                      "FAILED"
                    ]
                  },
                  "revision": {
                    "bsonType": [
                      "int",
                      "long"
                    ],
                    "minimum": 0
                  },
                  "createdAt": {
                    "bsonType": "date"
                  },
                  "updatedAt": {
                    "bsonType": "date"
                  },
                  "expiresAt": {
                    "bsonType": "date"
                  },
                  "acceptedAt": {
                    "bsonType": [
                      "date",
                      "null"
                    ]
                  },
                  "connectedAt": {
                    "bsonType": [
                      "date",
                      "null"
                    ]
                  },
                  "callerHeartbeatAt": {
                    "bsonType": [
                      "date",
                      "null"
                    ]
                  },
                  "calleeHeartbeatAt": {
                    "bsonType": [
                      "date",
                      "null"
                    ]
                  },
                  "connectedParticipantIds": {
                    "bsonType": "array",
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "bsonType": "string"
                    }
                  },
                  "endedAt": {
                    "bsonType": [
                      "date",
                      "null"
                    ]
                  },
                  "endedBy": {
                    "bsonType": [
                      "string",
                      "null"
                    ]
                  },
                  "endReason": {
                    "bsonType": [
                      "string",
                      "null"
                    ],
                    "maxLength": 200
                  }
                }
              }
            },
            {
              "$expr": {
                "$and": [
                  {
                    "$ne": [
                      "$callerId",
                      "$calleeId"
                    ]
                  },
                  {
                    "$setEquals": [
                      {
                        "$cond": [
                          {
                            "$isArray": "$participantIds"
                          },
                          "$participantIds",
                          []
                        ]
                      },
                      [
                        "$callerId",
                        "$calleeId"
                      ]
                    ]
                  },
                  {
                    "$cond": [
                      {
                        "$in": [
                          "$state",
                          [
                            "RINGING",
                            "CONNECTING",
                            "ACTIVE"
                          ]
                        ]
                      },
                      {
                        "$setEquals": [
                          {
                            "$cond": [
                              {
                                "$isArray": "$activeParticipantIds"
                              },
                              "$activeParticipantIds",
                              []
                            ]
                          },
                          {
                            "$cond": [
                              {
                                "$isArray": "$participantIds"
                              },
                              "$participantIds",
                              []
                            ]
                          }
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$type": "$activeParticipantIds"
                          },
                          "missing"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "validationLevel": "strict",
        "validationAction": "error"
      },
      "indexes": [
        {
          "v": 2,
          "key": {
            "_id": 1
          },
          "name": "_id_"
        },
        {
          "v": 2,
          "key": {
            "activeParticipantIds": 1
          },
          "name": "uq_chat_calls_active_participant",
          "unique": true,
          "partialFilterExpression": {
            "activeParticipantIds": {
              "$type": "array"
            }
          }
        },
        {
          "v": 2,
          "key": {
            "workspaceId": 1,
            "channelId": 1,
            "createdAt": -1,
            "_id": -1
          },
          "name": "idx_chat_calls_history"
        },
        {
          "v": 2,
          "key": {
            "state": 1,
            "expiresAt": 1
          },
          "name": "idx_chat_calls_expiry"
        }
      ],
      "documents": []
    },
