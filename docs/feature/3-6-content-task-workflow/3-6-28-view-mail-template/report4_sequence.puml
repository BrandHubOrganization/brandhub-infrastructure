@startuml 3.6.28 - View Mail Template
title Sequence Diagram — 3.6.28 - View Mail Template

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Member (OWNER/MANAGER/CREATOR)" as member
boundary "MailTemplateListPage (UI)" as ui
boundary "MailTemplateController" as controller
control "MailTemplateService" as service
entity "WorkspaceAccessService" as access
entity "MailTemplateRepository (MongoDB)" as repo
entity "MailTemplateResponse" as response

' === Flow ===
member -> ui: opens /workspaces/{id}/mail-templates
activate ui
ui -> controller: GET /api/v1/workspaces/{id}/mail-templates?includeSystem&q&page&size
activate controller
controller -> service: listTemplates(currentUser, workspaceId, query)
activate service
service -> access: requireActiveMember(workspaceId, userId)
activate access
access --> service: member(role)
deactivate access
opt role not in {OWNER, MANAGER, CREATOR}
  service --> controller: throw 403 FORBIDDEN
  deactivate service
  controller --> ui: 403 Forbidden
  deactivate controller
  ui --> member: shows access denied
end
activate controller
activate service
service -> repo: findVisible(workspaceId, includeSystem, q, pageable) where deletedAt == null
activate repo
repo --> service: Page<MailTemplateDocument>
deactivate repo
loop each template
  service -> response: map(name, subject preview, type, attachmentCount, createdAt)
  activate response
end
service --> controller: Page<MailTemplateResponse>
deactivate service
controller --> ui: 200 OK
deactivate controller
ui --> member: renders list (or empty state)
deactivate ui

deactivate response
@enduml