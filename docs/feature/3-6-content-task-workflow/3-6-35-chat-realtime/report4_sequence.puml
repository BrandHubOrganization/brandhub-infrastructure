@startuml 3.6.36 - Chat Realtime
title Sequence Diagram — 3.6.36 - Chat Realtime

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "WorkspaceMember" as workspacemember
control "ChatService" as chatservice
entity "SimpMessagingTemplate" as simpmessagingtemplat
entity "ChatMessageRepository" as chatmessagerepositor
boundary "WorkspaceChatUI" as workspacechatui
boundary "ChatController" as chatcontroller

' === Flow ===
workspacemember -> workspacechatui: navigates to workspace chat page (/workspaces/:id/chat)
activate workspacechatui
workspacechatui -> chatcontroller: GET /api/v1/workspaces/{workspaceId}/chat/messages?before=&limit=30
activate chatcontroller
chatcontroller -> chatservice: getHistory(workspaceId, userId, before, limit=30)
activate chatservice
chatservice -> chatmessagerepositor: findHistory(workspaceId, before, limit)
activate chatmessagerepositor
chatmessagerepositor --> chatservice: chatSlice
deactivate chatmessagerepositor
chatservice --> chatcontroller: ChatHistoryResponse
deactivate chatservice
chatcontroller --> workspacechatui: 200 OK (ChatHistoryResponse)
deactivate chatcontroller
workspacechatui --> workspacemember: render message history list with context chips & sender alignment
workspacemember ->> workspacechatui: types message (content, optional context), presses Enter
workspacechatui ->> chatcontroller: STOMP SEND /app/workspaces/{workspaceId}/chat.send (ChatSendRequest: clientMessageId, content, contextType, contextId)
activate chatcontroller
chatcontroller ->> chatservice: send(workspaceId, userId, request)
activate chatservice

alt caller is not active member in workspace
  chatservice --> chatcontroller: throw BusinessException (403 WORKSPACE_ACCESS_DENIED)
  deactivate chatservice
  workspacechatui --> workspacemember: show error toast ("Access denied to workspace chat")
  chatcontroller --> workspacechatui: STOMP @SendToUser(/queue/chat-errors) ChatErrorResponse
  deactivate chatcontroller
else duplicate clientMessageId detected (retry idempotency)
  activate chatcontroller
  activate chatservice
  chatservice ->> chatmessagerepositor: findByWorkspaceIdAndSenderUserIdAndClientMessageId(...)
  activate chatmessagerepositor
  chatmessagerepositor --> chatservice: existingMessage
  deactivate chatmessagerepositor
  chatservice --> chatcontroller: ChatMessageResponse (existing)
  deactivate chatservice
  chatcontroller ->> simpmessagingtemplat: convertAndSend(/topic/workspaces/{workspaceId}/chat, ChatEventResponse)
  activate simpmessagingtemplat
  simpmessagingtemplat --> chatcontroller: broadcast ChatEventResponse to workspace subscribers
  deactivate simpmessagingtemplat
  workspacechatui --> workspacemember: keep message state updated
  chatcontroller --> workspacechatui: acknowledge
  deactivate chatcontroller
else invalid message content or context
  activate chatcontroller
  activate chatservice
  chatservice --> chatcontroller: throw BusinessException (400 CHAT_MESSAGE_INVALID)
  deactivate chatservice
  chatcontroller --> workspacechatui: STOMP @SendToUser(/queue/chat-errors) ChatErrorResponse
  deactivate chatcontroller
  workspacechatui --> workspacemember: show validation error toast
else valid new message
  activate chatcontroller
  activate chatservice
  chatmessagerepositor --> chatservice: existingMessage
  chatservice ->> chatmessagerepositor: save(chatMessageDocument)
  activate chatmessagerepositor
  chatservice --> chatcontroller: ChatMessageResponse
  deactivate chatservice
  chatcontroller ->> simpmessagingtemplat: convertAndSend(/topic/workspaces/{workspaceId}/chat, ChatEventResponse)
  activate simpmessagingtemplat
  simpmessagingtemplat --> chatcontroller: broadcast ChatEventResponse to workspace subscribers
  deactivate simpmessagingtemplat
  chatcontroller --> workspacechatui: acknowledge
  deactivate chatcontroller
  workspacechatui --> workspacemember: keep message state updated
end
activate chatcontroller
activate chatservice

workspacemember ->> workspacechatui: views unread messages in chat viewport
workspacechatui ->> chatcontroller: PUT /api/v1/workspaces/{workspaceId}/chat/read (MarkChatReadRequest: lastReadMessageId)
chatcontroller ->> chatservice: markRead(workspaceId, userId, lastReadMessageId)
chatservice ->> chatmessagerepositor: updateLastReadState(workspaceId, userId, lastReadMessageId)
chatmessagerepositor --> chatservice: updatedState
deactivate chatmessagerepositor
chatservice --> chatcontroller: void
deactivate chatservice
chatcontroller --> workspacechatui: 200 OK
deactivate chatcontroller
workspacechatui --> workspacemember: update unread counter badge to 0
deactivate workspacechatui

@enduml