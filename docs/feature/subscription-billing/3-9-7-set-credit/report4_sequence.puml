@startuml 3.9.7 - Set Credit
title Sequence Diagram — 3.9.7 - Set Credit

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
entity "Web dashboard" as webdashboard
boundary "BillingController" as billingcontroller
control "BillingService" as billingservice
entity "WorkspaceRepository" as workspacerepository
entity "AiCreditWorkspaceLimitRepository" as aicreditworkspacelim
actor "OWNER (Workspace Agency)" as ownerworkspaceagency

' === Flow ===
billingservice -> billingservice: Validate OWNER role, nonnegative limit, period and expectedVersion
ownerworkspaceagency -> webdashboard: Confirm Workspace credit limit
webdashboard -> billingcontroller: PUT /api/v1/billing/credits/{agencyId}/limits
billingcontroller -> billingservice: setWorkspaceCreditLimit(user, command)
billingservice -> workspacerepository: Load workspace and agency OWNER access
workspacerepository --> billingservice: Workspace
billingservice -> aicreditworkspacelim: Load workspace credit limit and current usage
aicreditworkspacelim --> billingservice: AiCreditWorkspaceLimit

loop invalid access / validation error / conflict
  billingservice --> billingcontroller: 400 Bad Request / 403 Forbidden / 409 Conflict
  billingcontroller --> webdashboard: 400 Bad Request / 403 Forbidden / 409 Conflict
  webdashboard --> ownerworkspaceagency: Display validation or permission conflict error
end

billingservice -> aicreditworkspacelim: Save workspace limit with version check
aicreditworkspacelim --> billingservice: writeOutcome

alt writeOutcome committed
  billingservice --> billingcontroller: 200 OK
  billingcontroller --> webdashboard: 200 OK
  webdashboard --> ownerworkspaceagency: Display updated Workspace limit
else write failed or version conflict
  billingservice --> billingcontroller: 409 Conflict / 500 Internal Server Error
  billingcontroller --> webdashboard: 409 Conflict / 500 Internal Server Error
  webdashboard --> ownerworkspaceagency: Display save error; retain previous values
end

@enduml
