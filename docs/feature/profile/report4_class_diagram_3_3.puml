    class ClientProfile <<entity>> {
        - id: UUID
        - userId: UUID
        - displayName: String
        - company: String
        - phone: String
        - note: String
        - logoUrl: String
        - website: String
        - industry: String
        - location: String
        - description: String
        - socialLinks: String [jsonb]
        - contactName: String
        - contactEmail: String
        - companySize: String
        - instagramUrl: String
        - taxCode: String
        - address: String
        - tagline: String
        - foundedYear: Integer
        - budgetRange: String
        - bannerUrl: String
        - createdAt: OffsetDateTime
        - updatedAt: OffsetDateTime
    }
}

' ==========================================================
' ENUMS
