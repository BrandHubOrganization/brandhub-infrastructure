@startuml 3.3 - Profile Management Class Diagram
title Class Diagram — Module 3.3: Profile Management (BrandHub)

skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

skinparam class {
    BackgroundColor<<controller>> #E3F2FD
    BorderColor<<controller>> #1565C0
    BackgroundColor<<service>> #E8F5E9
    BorderColor<<service>> #2E7D32
    BackgroundColor<<repository>> #FFF3E0
    BorderColor<<repository>> #E65100
    BackgroundColor<<entity>> #F3E5F5
    BorderColor<<entity>> #7B1FA2
    BackgroundColor<<dto>> #ECEFF1
    BorderColor<<dto>> #455A64
    BackgroundColor<<enum>> #FFFDE7
    BorderColor<<enum>> #F57F17
}

' ==========================================================
' CONTROLLER LAYER
' ==========================================================
package "com.brandhub.business.controller" {
    class UserController <<controller>> {
        - userService: UserService
        + UserController(userService: UserService)
        + getProfile(currentUser: AuthenticatedUser, request: WebRequest): ResponseEntity<ApiResponse<UserProfileResponse>>
        + updateProfile(currentUser: AuthenticatedUser, updateRequest: UpdateProfileRequest, request: WebRequest): ResponseEntity<ApiResponse<UserProfileResponse>>
        + lookupByEmail(email: String, request: WebRequest): ResponseEntity<ApiResponse<UserLookupResponse>>
        + uploadAvatar(currentUser: AuthenticatedUser, file: MultipartFile, request: WebRequest): ResponseEntity<ApiResponse<AvatarResponse>>
        + uploadBanner(currentUser: AuthenticatedUser, file: MultipartFile, request: WebRequest): ResponseEntity<ApiResponse<BannerResponse>>
    }

    class ClientProfileController <<controller>> {
        - clientProfileService: ClientProfileService
        + ClientProfileController(clientProfileService: ClientProfileService)
        + listMine(currentUser: AuthenticatedUser, webRequest: WebRequest): ApiResponse<List<ClientProfileResponse>>
        + createProfile(currentUser: AuthenticatedUser, request: ClientProfileRequest, webRequest: WebRequest): ApiResponse<ClientProfileResponse>
        + uploadDraftLogo(currentUser: AuthenticatedUser, file: MultipartFile, webRequest: WebRequest): ApiResponse<String>
        + getById(currentUser: AuthenticatedUser, profileId: UUID, webRequest: WebRequest): ApiResponse<ClientProfileResponse>
        + updateById(currentUser: AuthenticatedUser, profileId: UUID, request: ClientProfileRequest, webRequest: WebRequest): ApiResponse<ClientProfileResponse>
        + uploadLogo(currentUser: AuthenticatedUser, profileId: UUID, file: MultipartFile, webRequest: WebRequest): ApiResponse<ClientProfileResponse>
        + deleteById(currentUser: AuthenticatedUser, profileId: UUID, webRequest: WebRequest): ApiResponse<Void>
    }
}

' ==========================================================
' SERVICE LAYER
' ==========================================================
package "com.brandhub.business.service" {
    interface UserService <<service>> {
        + getUserProfile(currentUser: AuthenticatedUser): UserProfileResponse
        + updateUserProfile(currentUser: AuthenticatedUser, updateRequest: UpdateProfileRequest): UserProfileResponse
        + updateAvatar(currentUser: AuthenticatedUser, file: MultipartFile): String
        + updateBanner(currentUser: AuthenticatedUser, file: MultipartFile): String
        + lookupByEmail(email: String): Optional<UserLookupResponse>
    }

    class UserServiceImpl <<service>> {
        - userRepository: UserRepository
        - emailService: EmailService
        - userSystemRoleRepository: UserSystemRoleRepository
        - workspaceMemberRepository: WorkspaceMemberRepository
        - fileStorageService: FileStorageService
        - objectMapper: ObjectMapper
        + getUserProfile(currentUser: AuthenticatedUser): UserProfileResponse
        + updateUserProfile(currentUser: AuthenticatedUser, updateRequest: UpdateProfileRequest): UserProfileResponse
        + updateAvatar(currentUser: AuthenticatedUser, file: MultipartFile): String
        + updateBanner(currentUser: AuthenticatedUser, file: MultipartFile): String
        + lookupByEmail(email: String): Optional<UserLookupResponse>
        - toResponse(user: User, currentUser: AuthenticatedUser): UserProfileResponse
        - validateImage(file: MultipartFile): String
        - parsePreferences(user: User): Map<String, Object>
    }

    interface ClientProfileService <<service>> {
        + listMine(currentUser: AuthenticatedUser): List<ClientProfileResponse>
        + createProfile(currentUser: AuthenticatedUser, request: ClientProfileRequest): ClientProfileResponse
        + getById(currentUser: AuthenticatedUser, profileId: UUID): ClientProfileResponse
        + updateById(currentUser: AuthenticatedUser, profileId: UUID, request: ClientProfileRequest): ClientProfileResponse
        + updateLogo(currentUser: AuthenticatedUser, profileId: UUID, file: MultipartFile): ClientProfileResponse
        + uploadDraftLogo(currentUser: AuthenticatedUser, file: MultipartFile): String
        + deleteById(currentUser: AuthenticatedUser, profileId: UUID): void
    }

    class ClientProfileServiceImpl <<service>> {
        - clientProfileRepository: ClientProfileRepository
        - workspaceMemberRepository: WorkspaceMemberRepository
        - fileStorageService: FileStorageService
        - objectMapper: ObjectMapper
        + listMine(currentUser: AuthenticatedUser): List<ClientProfileResponse>
        + createProfile(currentUser: AuthenticatedUser, request: ClientProfileRequest): ClientProfileResponse
        + getById(currentUser: AuthenticatedUser, profileId: UUID): ClientProfileResponse
        + updateById(currentUser: AuthenticatedUser, profileId: UUID, request: ClientProfileRequest): ClientProfileResponse
        + updateLogo(currentUser: AuthenticatedUser, profileId: UUID, file: MultipartFile): ClientProfileResponse
        + uploadDraftLogo(currentUser: AuthenticatedUser, file: MultipartFile): String
        + deleteById(currentUser: AuthenticatedUser, profileId: UUID): void
        - applyRequest(profile: ClientProfile, request: ClientProfileRequest): void
        - findOwnedProfileOrThrow(currentUser: AuthenticatedUser, profileId: UUID): ClientProfile
        - toResponse(profile: ClientProfile): ClientProfileResponse
    }
}

' ==========================================================
' REPOSITORY LAYER
' ==========================================================
package "com.brandhub.business.repository" {
    interface UserRepository <<repository>> {
        + findById(id: UUID): Optional<User>
        + save(user: User): User
        + findByEmail(email: String): Optional<User>
    }

    interface UserSystemRoleRepository <<repository>> {
        + findByUserId(userId: UUID): Optional<UserSystemRole>
    }

    interface ClientProfileRepository <<repository>> {
        + findByUserId(userId: UUID): List<ClientProfile>
        + findById(id: UUID): Optional<ClientProfile>
        + save(profile: ClientProfile): ClientProfile
        + delete(profile: ClientProfile): void
    }

    interface WorkspaceMemberRepository <<repository>> {
        + findFirstByUserIdAndIsActiveTrue(userId: UUID): Optional<WorkspaceMember>
        + findByClientProfileIdInAndIsActiveTrue(clientProfileIds: List<UUID>): List<WorkspaceMember>
    }
}

