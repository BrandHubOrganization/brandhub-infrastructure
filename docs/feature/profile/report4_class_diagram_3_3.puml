' ==========================================================
' RELATIONSHIPS & DEPENDENCIES
' ==========================================================

' Controller -> Service (Dependency)
UserController ..> UserService : delegates
ClientProfileController ..> ClientProfileService : delegates

' Service Implementations (Realization)
UserServiceImpl ..|> UserService : implements
ClientProfileServiceImpl ..|> ClientProfileService : implements

' Service -> Repository (Dependency)
UserServiceImpl ..> UserRepository : uses
UserServiceImpl ..> UserSystemRoleRepository : uses
UserServiceImpl ..> WorkspaceMemberRepository : uses
ClientProfileServiceImpl ..> ClientProfileRepository : uses
ClientProfileServiceImpl ..> WorkspaceMemberRepository : uses

' Repository -> Entity (Dependency)
UserRepository ..> User : manages
UserSystemRoleRepository ..> UserSystemRole : manages
ClientProfileRepository ..> ClientProfile : manages

' Entity Associations & Compositions
User "1" *-- "0..1" UserSystemRole : system role
User "1" o-- "0..*" ClientProfile : owns profiles
User --> UserStatus : status
UserSystemRole --> SystemRole : systemRole

' DTO Usage (Dependency)
UserController ..> UpdateProfileRequest : consumes
UserController ..> UserProfileResponse : returns
UserController ..> UserLookupResponse : returns
UserController ..> AvatarResponse : returns
UserController ..> BannerResponse : returns

ClientProfileController ..> ClientProfileRequest : consumes
ClientProfileController ..> ClientProfileResponse : returns

UserServiceImpl ..> UpdateProfileRequest : transforms
UserServiceImpl ..> UserProfileResponse : creates
UserServiceImpl ..> UserLookupResponse : creates

ClientProfileServiceImpl ..> ClientProfileRequest : transforms
ClientProfileServiceImpl ..> ClientProfileResponse : creates

@enduml
