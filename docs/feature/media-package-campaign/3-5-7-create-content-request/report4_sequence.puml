@startuml 3.5.7 - Create Content Request
title Sequence Diagram — 3.5.7 - Create Content Request

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
entity "ContentRequestRepository" as contentrequestreposi
control "ContentRequestService" as contentrequestservic
boundary "ContentRequestController" as contentrequestcontro
boundary "CreateContentRequestModal (UI)" as createcontentrequest
actor "Client" as client

' === Flow ===
client -> createcontentrequest: enters title, description, type (POST|LIVESTREAM|SURVEY), dueDate & clicks "Submit Request"
activate createcontentrequest
createcontentrequest -> contentrequestcontro: POST /api/v1/workspaces/{workspaceId}/content-requests (CreateContentRequestPayload, headers: Bearer accessToken)
activate contentrequestcontro
contentrequestservic -> contentrequestservic: validateWorkspaceClient(workspaceId, userId)
else payload valid & client authorized
  contentrequestservic -> contentrequestservic: buildContentRequest(workspaceId, userId, payload)
end

contentrequestcontro -> contentrequestservic: createContentRequest(workspaceId, userId, payload)
activate contentrequestservic

alt caller is not authorized workspace Client
  contentrequestservic --> contentrequestcontro: throw AccessDeniedException (403 Forbidden)
  deactivate contentrequestservic
  contentrequestcontro --> createcontentrequest: 403 Forbidden (WORKSPACE_ACCESS_DENIED)
  deactivate contentrequestcontro
  createcontentrequest --> client: show error toast ('Access denied: Only workspace clients can create content requests')
else payload validation failed (missing title, invalid type, or past due date)
  activate contentrequestcontro
  activate contentrequestservic
  contentrequestservic --> contentrequestcontro: throw ValidationException (400 Bad Request)
  deactivate contentrequestservic
  contentrequestcontro --> createcontentrequest: 400 Bad Request (INVALID_CONTENT_REQUEST_PAYLOAD)
  deactivate contentrequestcontro
  createcontentrequest --> client: display field error messages ('Invalid payload: check required fields and due date')
else payload valid & client authorized
  activate contentrequestcontro
  activate contentrequestservic
  contentrequestservic ->> contentrequestreposi: save(contentRequest)
  activate contentrequestreposi
  contentrequestreposi --> contentrequestservic: savedRequest
  deactivate contentrequestreposi
  contentrequestservic --> contentrequestcontro: ContentRequestResponse (id, workspaceId, title, type, dueDate, status=PENDING, createdAt)
  deactivate contentrequestservic
  contentrequestcontro --> createcontentrequest: 201 Created (ContentRequestResponse)
  deactivate contentrequestcontro
  createcontentrequest --> client: show success toast ('Content request submitted as PENDING') & refresh request list
  deactivate createcontentrequest
end

@enduml