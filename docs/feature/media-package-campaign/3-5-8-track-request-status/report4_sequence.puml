@startuml 3.5.8 - Track Content Request Status
title Sequence Diagram — 3.5.8 - Track Content Request Status

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
entity "TaskRepository" as taskrepository
entity "ContentRequestRepository" as contentrequestreposi
control "ContentRequestService" as contentrequestservic
boundary "ContentRequestPage (UI)" as contentrequestpageui
boundary "ContentRequestController" as contentrequestcontro
actor "Mânger" as mnger

' === Flow ===
mnger -> contentrequestpageui: navigates to Content Requests board / list
activate contentrequestpageui
activate contentrequestcontro
contentrequestcontro -> contentrequestservic: getContentRequests(workspaceId, userId, queryParams)
activate contentrequestservic
else transition: PENDING or IN_PROGRESS to ACCEPTED (Idempotent Task Creation)
  contentrequestservic -> contentrequestservic: claimAcceptanceAtomic(workspaceId, requestId)
end

contentrequestpageui -> contentrequestcontro: GET /api/v1/workspaces/{workspaceId}/content-requests (queryParams: page, limit, status, headers: Bearer accessToken)
contentrequestservic -> contentrequestreposi: findByWorkspaceId(workspaceId, queryParams)
activate contentrequestreposi
contentrequestreposi --> contentrequestservic: requestPage
deactivate contentrequestreposi
contentrequestservic --> contentrequestcontro: ContentRequestPageResponse
deactivate contentrequestservic
contentrequestpageui --> mnger: render requests list with status badges (PENDING, IN_PROGRESS, ACCEPTED, DENIED)
contentrequestcontro --> contentrequestpageui: 200 OK (ContentRequestPageResponse)
deactivate contentrequestcontro
mnger ->> contentrequestpageui: selects request & clicks "Update Status" (e.g. IN_PROGRESS or ACCEPTED)
activate contentrequestcontro
contentrequestcontro ->> contentrequestservic: updateContentRequestStatus(workspaceId, requestId, userId, payload)
activate contentrequestservic
contentrequestpageui ->> contentrequestcontro: PATCH /api/v1/workspaces/{workspaceId}/content-requests/{requestId}/status (UpdateStatusPayload(targetStatus, note), headers: Bearer accessToken)
contentrequestservic -> contentrequestservic: validateManagerRole(workspaceId, userId)

alt caller is not authorized Manager
  contentrequestservic --> contentrequestcontro: throw AccessDeniedException (403 Forbidden)
  deactivate contentrequestservic
  contentrequestcontro --> contentrequestpageui: 403 Forbidden (MANAGER_ROLE_REQUIRED)
  deactivate contentrequestcontro
  contentrequestpageui --> mnger: show error toast ('Only agency managers can update request status')
else authorized Manager
  activate contentrequestcontro
  activate contentrequestservic
  contentrequestservic ->> contentrequestreposi: findByWorkspaceIdAndId(workspaceId, requestId)
  activate contentrequestreposi
  contentrequestreposi --> contentrequestservic: request
  deactivate contentrequestreposi
end


alt request not found
  contentrequestservic --> contentrequestcontro: throw ResourceNotFoundException (404 Not Found)
  deactivate contentrequestservic
  contentrequestcontro --> contentrequestpageui: 404 Not Found (REQUEST_NOT_FOUND)
  deactivate contentrequestcontro
  contentrequestpageui --> mnger: show error toast ('Content request not found')
else terminal state reached (status is ACCEPTED, DENIED, or CANCELLED)
  activate contentrequestcontro
  activate contentrequestservic
  contentrequestservic --> contentrequestcontro: throw IllegalStateException (409 Conflict)
  deactivate contentrequestservic
  contentrequestcontro --> contentrequestpageui: 409 Conflict (TERMINAL_STATE_CANNOT_BE_REOPENED)
  deactivate contentrequestcontro
  contentrequestpageui --> mnger: show error modal ('Terminal state cannot be reopened')
else transition: PENDING to IN_PROGRESS
  activate contentrequestcontro
  activate contentrequestservic
  contentrequestservic ->> contentrequestreposi: updateStatus(workspaceId, requestId, IN_PROGRESS, note)
  activate contentrequestreposi
  contentrequestreposi --> contentrequestservic: updatedRequest
  deactivate contentrequestreposi
  contentrequestservic --> contentrequestcontro: ContentRequestResponse (status=IN_PROGRESS)
  deactivate contentrequestservic
  contentrequestcontro --> contentrequestpageui: 200 OK (ContentRequestResponse)
  deactivate contentrequestcontro
  contentrequestpageui --> mnger: update badge to IN_PROGRESS & show success toast
else transition: PENDING or IN_PROGRESS to ACCEPTED (Idempotent Task Creation)
  activate contentrequestcontro
  activate contentrequestservic
  contentrequestservic ->> contentrequestreposi: updateStatus(workspaceId, requestId, ACCEPTED)
  activate contentrequestreposi
  contentrequestreposi --> contentrequestservic: acceptedRequest
  deactivate contentrequestreposi
  contentrequestservic ->> taskrepository: createBacklogTask(workspaceId, campaignId=null, title, description, type, dueDate, sourceType=CONTENT_REQUEST, sourceRefId=requestId)
  activate taskrepository
  taskrepository --> contentrequestservic: createdTask
  deactivate taskrepository
  contentrequestservic ->> contentrequestreposi: setGeneratedTaskId(requestId, createdTask.id)
  activate contentrequestreposi
  contentrequestreposi --> contentrequestservic: finalizedRequest
  deactivate contentrequestreposi
  contentrequestservic --> contentrequestcontro: ContentRequestResponse (status=ACCEPTED, generatedTaskId=createdTask.id)
  deactivate contentrequestservic
  contentrequestcontro --> contentrequestpageui: 200 OK (ContentRequestResponse)
  deactivate contentrequestcontro
  contentrequestpageui --> mnger: update badge to ACCEPTED, display linked task link & show success toast
  deactivate contentrequestpageui
end

@enduml