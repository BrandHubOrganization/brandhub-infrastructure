@startuml 3.5.6 - Approve Media Campaign
title Sequence Diagram — 3.5.6 - Approve Media Campaign

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
entity "TaskRepository (MongoDB)" as taskrepositorymongod
entity "MediaCampaignRepository" as mediacampaignreposit
control "MediaCampaignService" as mediacampaignservice
boundary "MediaCampaignController" as mediacampaigncontrol
boundary "MediaCampaignUI" as mediacampaignui
actor "User (Client / Manager)" as userclientmanager

' === Flow ===
userclientmanager -> mediacampaignui: reviews campaign work items & clicks "Approve Campaign"

alt caller is Client
  mediacampaignservice -> mediacampaignservice: set approvedByClientAt = now
else caller is Agency (Owner or Manager)
  mediacampaignservice -> mediacampaignservice: set approvedByAgencyAt = now
end

else both Agency and Client approved current contentVersion
  mediacampaignservice -> mediacampaignservice: set status = IN_PROGRESS
end

mediacampaignui -> mediacampaigncontrol: POST /api/v1/media-campaigns/{campaignId}/approve
mediacampaigncontrol -> mediacampaignservice: approveCampaign(campaignId, currentUser)
mediacampaignservice -> mediacampaignreposit: findByIdForUpdate(campaignId)
mediacampaignreposit --> mediacampaignservice: campaign

alt campaign not found
  mediacampaignservice --> mediacampaigncontrol: throw BusinessException (404 CAMPAIGN_NOT_FOUND)
  mediacampaigncontrol --> mediacampaignui: 404 Not Found (CAMPAIGN_NOT_FOUND)
  mediacampaignui --> userclientmanager: show error toast ('Campaign not found')
else campaign already active or status != DRAFT
  mediacampaignservice --> mediacampaigncontrol: throw BusinessException (400 CAMPAIGN_ALREADY_ACTIVE)
  mediacampaigncontrol --> mediacampaignui: 400 Bad Request (CAMPAIGN_ALREADY_ACTIVE)
  mediacampaignui --> userclientmanager: show error toast ('Campaign is already in progress or completed')
else caller is unauthorized (not workspace Client or Agency Manager)
  mediacampaignservice --> mediacampaigncontrol: throw BusinessException (403 WORKSPACE_ACCESS_DENIED)
  mediacampaigncontrol --> mediacampaignui: 403 Forbidden (WORKSPACE_ACCESS_DENIED)
  mediacampaignui --> userclientmanager: show error toast ('Access denied: Client or Agency Manager role required')
end


alt single party approved (pending second party confirmation)
  mediacampaignservice ->> mediacampaignreposit: save(campaign)
  mediacampaignreposit --> mediacampaignservice: savedCampaign
  mediacampaignservice --> mediacampaigncontrol: MediaCampaignResponse (approved timestamp recorded)
  mediacampaigncontrol --> mediacampaignui: 200 OK (partially approved)
  mediacampaignui --> userclientmanager: show toast ('Approval recorded. Awaiting confirmation from second party')
end


break each workItem in campaign.workItems JSONB
  mediacampaignservice ->> taskrepositorymongod: upsertTask({campaignId, campaignWorkItemId: workItem.id}, taskData)
  taskrepositorymongod --> mediacampaignservice: upsertedTaskDocument
end

else both Agency and Client approved current contentVersion
  mediacampaignservice ->> mediacampaignreposit: save(campaign)
  mediacampaignreposit --> mediacampaignservice: savedCampaign (status: IN_PROGRESS)
  mediacampaignservice --> mediacampaigncontrol: MediaCampaignResponse (status: IN_PROGRESS)
  mediacampaigncontrol --> mediacampaignui: 200 OK (MediaCampaignResponse)
  mediacampaignui --> userclientmanager: show success modal ('Campaign fully approved! Work items deployed to Task Backlog')
end

@enduml
