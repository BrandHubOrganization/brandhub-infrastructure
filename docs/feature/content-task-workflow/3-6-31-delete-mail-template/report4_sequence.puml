@startuml 3.6.31 - Delete Mail Template
title Sequence Diagram — 3.6.31 - Delete Mail Template

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Member (creator or OWNER/MANAGER)" as member
boundary "DeleteMailTemplateConfirmDialog (UI)" as ui
boundary "MailTemplateController" as controller
control "MailTemplateService" as service
entity "WorkspaceAccessService" as access
entity "MailTemplateRepository (MongoDB)" as repo

' === Flow ===
member -> ui: clicks Delete on a template row and confirms
ui -> controller: DELETE /api/v1/workspaces/{id}/mail-templates/{templateId}
controller -> service: deleteTemplate(currentUser, workspaceId, templateId)
service -> access: requireActiveMember(workspaceId, userId)
access --> service: member(role)
service -> repo: findByIdAndDeletedAtIsNull(templateId)
repo --> service: Optional<template>
opt template missing or other Workspace
  service --> controller: throw 404 TEMPLATE_NOT_FOUND
  controller --> ui: 404 Not Found
end
opt template.type == SYSTEM_DEFAULT
  service --> controller: throw 403 SYSTEM_TEMPLATE_READ_ONLY
  controller --> ui: 403 Forbidden
end
opt caller is not creator and role not in {OWNER, MANAGER}
  service --> controller: throw 403 FORBIDDEN
  controller --> ui: 403 Forbidden
  ui --> member: shows forbidden toast
end
service -> repo: save(template.softDelete()) sets deletedAt = now
repo --> service: void
service --> controller: void
controller --> ui: 200 OK (data: null)
ui --> member: removes row, success toast
note right of service
  Soft delete only. mail_batches and mail_deliveries
  that reference the template are not touched.
end note

@enduml
