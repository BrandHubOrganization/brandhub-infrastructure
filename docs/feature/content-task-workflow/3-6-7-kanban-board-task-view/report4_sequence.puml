@startuml 3.6.7 - Kanban Board Task View
title Sequence Diagram — 3.6.7 - Kanban Board Task View

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Creator / Client / Manager" as creatorclientmanager
boundary "TaskController" as taskcontroller
boundary "TaskCalendarPage (UI)" as taskcalendarpageui
entity "TaskKanbanResponse" as taskkanbanresponse
entity "TaskRepository" as taskrepository
control "TaskServiceImpl" as taskserviceimpl

' === Flow ===
taskserviceimpl -> taskserviceimpl: groupTasksIntoColumns(tasks, groupBy)
creatorclientmanager -> taskcalendarpageui: Select "Kanban Board" tab
taskcalendarpageui -> taskcontroller: Request tasks kanban board (groupBy)
taskcontroller -> taskserviceimpl: getTasksKanbanBoard(groupBy)
taskserviceimpl -> taskrepository: findTasks()
taskrepository --> taskserviceimpl: return List<Task>
taskserviceimpl -> taskkanbanresponse: mapToKanbanResponse(columns)
taskkanbanresponse --> taskserviceimpl: return kanbanData
taskcalendarpageui --> creatorclientmanager: Render Kanban columns with draggable task cards
taskserviceimpl --> taskcontroller: return kanbanData
taskcontroller --> taskcalendarpageui: return 200 OK (Kanban columns, task cards per column)

opt Drag Task card to new Column (Creator / Manager only)
  creatorclientmanager -> taskcalendarpageui: Drag card from "IN_PROGRESS" to "REVIEW"
end


alt User is Client (View-only)
  taskcalendarpageui --> creatorclientmanager: Disable card dragging / show tooltip ("Read-only permission")
else User is Creator or Manager
  taskcalendarpageui -> taskcontroller: Request move task card (newStatus)
  taskcontroller -> taskserviceimpl: updateTaskStatusByKanban(taskId, newStatus)
  taskserviceimpl -> taskrepository: findTask(taskId)
  taskrepository --> taskserviceimpl: return Task
end


alt Invalid Transition (e.g., skip review to completed)
  taskserviceimpl --> taskcontroller: throw INVALID_STATUS_TRANSITION (409 Conflict)
  taskcontroller --> taskcalendarpageui: return 409 Conflict (Illegal state transition to target status)
  taskcalendarpageui --> creatorclientmanager: Revert card position & display validation warning toast
else Valid Transition
  taskserviceimpl -> taskserviceimpl: task.setStatus(newStatus)
  taskserviceimpl -> taskrepository: save(task)
  taskrepository --> taskserviceimpl: return updatedTask
  taskserviceimpl --> taskcontroller: return savedTask
  taskcontroller --> taskcalendarpageui: return 200 OK (Updated task status)
  taskcalendarpageui --> creatorclientmanager: Snap card to new column & trigger status update
end

@enduml
