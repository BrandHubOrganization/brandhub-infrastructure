@startuml 3.6.4 - List Task View
title Sequence Diagram — 3.6.4 - List Task View

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Creator / Client / Manager" as creatorclientmanager
entity "TaskListResponse" as tasklistresponse
entity "TaskRepository" as taskrepository
control "TaskServiceImpl" as taskserviceimpl
boundary "TaskController" as taskcontroller
boundary "TaskListPage (UI)" as tasklistpageui

' === Flow ===
creatorclientmanager -> tasklistpageui: Select "List View" tab on Tasks board
activate tasklistpageui
tasklistpageui -> taskcontroller: Request tasks list view (page, size, sortBy)
activate taskcontroller
taskcontroller -> taskserviceimpl: getTasksListView(pageable)
activate taskserviceimpl
taskserviceimpl -> taskrepository: findTasks(pageable)
activate taskrepository
taskrepository --> taskserviceimpl: return Page<Task>
deactivate taskrepository

alt Tasks Exist (Page contains items)
  taskserviceimpl -> tasklistresponse: mapToSummaryList(pageTasks)
  activate tasklistresponse
  tasklistresponse --> taskserviceimpl: return taskItems
  deactivate tasklistresponse
  taskserviceimpl --> taskcontroller: return pagedTasks
  deactivate taskserviceimpl
  taskcontroller --> tasklistpageui: return 200 OK (Task list items, pagination metadata)
  deactivate taskcontroller
  tasklistpageui --> creatorclientmanager: Render task table with columns & Pagination controls
else Empty Workspace (No tasks found)
  activate taskserviceimpl
  activate taskcontroller
  taskserviceimpl --> taskcontroller: return emptyPagedResult
  deactivate taskserviceimpl
  taskcontroller --> tasklistpageui: return 200 OK (Empty task list, zero pagination)
  deactivate taskcontroller
  tasklistpageui --> creatorclientmanager: Display Empty State with CTA ("Create first Campaign or Content Request")
  deactivate tasklistpageui
end

@enduml