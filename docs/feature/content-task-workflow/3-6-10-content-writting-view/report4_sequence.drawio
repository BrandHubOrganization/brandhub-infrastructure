        <!-- Note: Client B collapsed to a single compact lane label on the far edge to keep the diagram width sane; its messages are drawn against c7's right edge. -->
        <mxCell id="noteB" value="Creator B / Client B: symmetric to A — runs the same open + edit-loop steps below with A and B swapped. Only the cross-client broadcast (steps 14-16) is drawn explicitly to avoid duplicating the whole flow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1470" width="230" height="60" as="geometry"/>
        </mxCell>

        <!-- 1. Open content -->
        <mxCell id="m1" value="1. opens Content Writing page (/workspaces/:id/content-writing)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="180" as="sourcePoint"/><mxPoint x="305" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2. GET /workspaces/{id}/tasks/{taskId}/content" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="220" as="sourcePoint"/><mxPoint x="555" y="220" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="frame1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="1120" height="150" as="geometry"/></mxCell>
        <mxCell id="alt1" value="alt" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="cond1" value="[Task not found, or not type POST, or caller not MANAGER/CREATOR]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="536" y="250" width="500" height="20" as="geometry"/></mxCell>
        <mxCell id="m3" value="3. throw 404 TASK_NOT_FOUND / 400 INVALID_TASK_TYPE_FOR_CONTENT_WRITING / 403 FORBIDDEN (@RequireRole)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="300" as="sourcePoint"/><mxPoint x="305" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="altdiv1" style="html=1;endArrow=none;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="330" as="sourcePoint"/><mxPoint x="1590" y="330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="cond2" value="[else — valid Task]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="476" y="334" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="m4" value="4. findPostTaskOrThrow + load latest TaskContentSnapshot + tail operations after it" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="370" as="sourcePoint"/><mxPoint x="1475" y="370" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="5. 200 { snapshot, operationsSinceSnapshot[], sequenceNumber }" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="395" as="sourcePoint"/><mxPoint x="305" y="395" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="m6" value="6. Y.applyUpdate(yDoc, snapshot); operationsSinceSnapshot.forEach(Y.applyUpdate) — reconstructs the Y.Doc" style="html=1;endArrow=block;dashed=0;fontSize=11;align=left;verticalAlign=top;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="430" as="sourcePoint"/><mxPoint x="310" y="450" as="targetPoint"/><Array as="points"><mxPoint x="340" y="430"/><mxPoint x="340" y="450"/></Array></mxGeometry></mxCell>

        <!-- 7. WS connect -->
        <mxCell id="m7" value="7. connect STOMP WS /ws/tasks?token=&lt;JWT&gt;" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="480" as="sourcePoint"/><mxPoint x="775" y="480" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="frame2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="680" y="510" width="910" height="100" as="geometry"/></mxCell>
        <mxCell id="alt2" value="alt" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="680" y="510" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="cond3" value="[token missing or invalid]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="746" y="510" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="m8" value="8. handshake rejected, 401" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="560" as="sourcePoint"/><mxPoint x="305" y="560" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="altdiv2" style="html=1;endArrow=none;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="585" as="sourcePoint"/><mxPoint x="1590" y="585" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="cond4" value="[else — JwtUtil.parseToken succeeds]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="686" y="589" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="m9" value="9. attributes[authenticatedUser] set; PrincipalHandshakeHandler binds STOMP Principal" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="600" as="sourcePoint"/><mxPoint x="1005" y="600" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="m10" value="10. subscribe /topic/tasks/{taskId}/content" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="650" as="sourcePoint"/><mxPoint x="1005" y="650" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Edit loop -->
        <mxCell id="m11" value="11. Creator A types — offscreen contenteditable captures keystroke/IME" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="700" as="sourcePoint"/><mxPoint x="305" y="700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="12. yText.insert/delete(caretIndex, ...) — local Yjs mutation, canvas re-renders optimistically (no wait for server)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=left;verticalAlign=top;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="730" as="sourcePoint"/><mxPoint x="310" y="750" as="targetPoint"/><Array as="points"><mxPoint x="340" y="730"/><mxPoint x="340" y="750"/></Array></mxGeometry></mxCell>
        <mxCell id="m13" value="13. yDoc 'update' event (origin != 'remote') -&gt; STOMP publish /app/tasks/{taskId}/content { update: base64 }" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="790" as="sourcePoint"/><mxPoint x="1005" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="14. appendOperation(taskId, update, currentUser) — nextSequence = count+1" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="830" as="sourcePoint"/><mxPoint x="1235" y="830" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="15. INSERT task_content_operations (opaque base64 Yjs update — server never decodes it)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1235" y="870" as="sourcePoint"/><mxPoint x="1475" y="870" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="16. convertAndSend /topic/tasks/{taskId}/content { update, sequenceNumber, editedBy } — to every subscriber, including sender" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="910" as="sourcePoint"/><mxPoint x="305" y="910" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="17. broadcast also reaches Client B" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="940" as="sourcePoint"/><mxPoint x="1590" y="940" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="18. Client A: Y.applyUpdate(yDoc, ownUpdate, 'remote') confirms official sequenceNumber" style="html=1;endArrow=block;dashed=0;fontSize=11;align=left;verticalAlign=top;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="970" as="sourcePoint"/><mxPoint x="310" y="990" as="targetPoint"/><Array as="points"><mxPoint x="340" y="970"/><mxPoint x="340" y="990"/></Array></mxGeometry></mxCell>
        <mxCell id="m19" value="19. Client B: Y.applyUpdate(yDoc, update, 'remote') — Yjs merges concurrent edits (CRDT), canvas re-renders affected region" style="html=1;endArrow=block;dashed=0;fontSize=11;align=left;verticalAlign=top;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1000" as="sourcePoint"/><mxPoint x="1550" y="1020" as="targetPoint"/><Array as="points"><mxPoint x="1580" y="1000"/><mxPoint x="1580" y="1020"/></Array></mxGeometry></mxCell>

        <mxCell id="noteSym" value="Symmetric: when Creator B edits, steps 11-19 run identically with A and B swapped — both Y.Docs converge to the same state regardless of order (CRDT guarantee, no central transform step needed)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="1050" width="1390" height="40" as="geometry"/>
        </mxCell>

        <!-- Snapshot report -->
        <mxCell id="frame3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="200" y="1110" width="1390" height="140" as="geometry"/></mxCell>
        <mxCell id="opt1" value="opt" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="200" y="1110" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="cond5" value="[operationsSinceSnapshot &gt;= 200 — client-reported, server never decodes Yjs updates so it can't snapshot itself; TaskContentSnapshotJob only logs which Tasks are due]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="266" y="1110" width="1100" height="20" as="geometry"/></mxCell>
        <mxCell id="m20" value="20. POST /workspaces/{id}/tasks/{taskId}/content/snapshot { yjsState: base64(Y.encodeStateAsUpdate(yDoc)), atSequenceNumber }" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="1160" as="sourcePoint"/><mxPoint x="555" y="1160" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m21" value="21. reportSnapshot — skip if a snapshot already exists at/after atSequenceNumber (first reporter wins)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="1200" as="sourcePoint"/><mxPoint x="1235" y="1200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m22" value="22. INSERT task_content_snapshots" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1235" y="1230" as="sourcePoint"/><mxPoint x="1475" y="1230" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Version history / restore -->
        <mxCell id="m23" value="23. GET /workspaces/{id}/tasks/{taskId}/content/versions — VersionHistorySidebar" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="1280" as="sourcePoint"/><mxPoint x="555" y="1280" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m24" value="24. listVersions -&gt; 200 [{ snapshotId, sequenceNumber, createdAt }]" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="1310" as="sourcePoint"/><mxPoint x="80" y="1310" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m25" value="25. clicks Restore -&gt; POST .../content/versions/{snapshotId}/restore" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="1350" as="sourcePoint"/><mxPoint x="555" y="1350" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m26" value="26. restoreVersion — append a NEW snapshot carrying the old yjsState at a fresh sequenceNumber (append-only; history stays intact)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="1390" as="sourcePoint"/><mxPoint x="1475" y="1390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m27" value="27. 200 { snapshot: restored yjsState, ... } -&gt; page reloads this client's Y.Doc from the restored state" style="html=1;endArrow=open;dashed=1;fontSize=11;align=center;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="1430" as="sourcePoint"/><mxPoint x="80" y="1430" as="targetPoint"/></mxGeometry></mxCell>

