        <mxCell id="c3" value="&#171;Boundary&#187;&lt;br&gt;TaskController (REST)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
