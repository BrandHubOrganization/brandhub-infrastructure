        <mxCell id="note1" value="FR 3.6.10 Content Writing View — implemented (minimal Task, not full FR 3.6.1; Yjs CRDT over STOMP WebSocket, not hand-written OT — see plan.md §6 direction B). Lifelines below match the real classes in brandhub-business-service and brandhub-web-dashboard." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="60" as="geometry"/>
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="c1" value="&#171;Actor&#187;&lt;br&gt;Creator A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
