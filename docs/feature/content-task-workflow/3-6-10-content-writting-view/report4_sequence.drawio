        <mxCell id="c8" value="&#171;Boundary&#187;&lt;br&gt;CanvasTextEditor + useTaskContentSync (Client B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
