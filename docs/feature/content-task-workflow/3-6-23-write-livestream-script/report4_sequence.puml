@startuml 3.6.23 - Write Livestream Script
title Sequence Diagram — 3.6.23 - Write Livestream Script

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Creator" as creator
boundary "LivestreamTaskController" as livestreamtaskcontro
entity "LivestreamIdeaResponse" as livestreamidearespon
entity "TaskRepository" as taskrepository
control "LivestreamTaskServiceImpl" as livestreamtaskservic
boundary "TaskDetailPage (UI)" as taskdetailpageui

' === Flow ===
creator -> taskdetailpageui: Enter timeline segments (timeMark, content, speaker, shotList) & click "Save Script"
taskdetailpageui -> livestreamtaskcontro: PATCH /api/v1/workspaces/{wId}/tasks/{taskId}/livestream/script { "segments": [...] }
livestreamtaskcontro -> livestreamtaskservic: saveLivestreamScript(workspaceId, taskId, scriptRequest, creatorUser)
livestreamtaskservic -> taskrepository: findByIdAndWorkspaceId(taskId, workspaceId)
taskrepository --> livestreamtaskservic: return Optional<Task>

alt Task Not Found (Optional is empty)
  livestreamtaskservic --> livestreamtaskcontro: throw TASK_NOT_FOUND (404 Not Found)
  livestreamtaskcontro --> taskdetailpageui: return 404 Not Found (Task not found in workspace)
  taskdetailpageui --> creator: Display error: "Task not found in workspace"
else Task is not LIVESTREAM type (task.getType() != 'LIVESTREAM')
  livestreamtaskservic --> livestreamtaskcontro: throw INVALID_TASK_TYPE (400 Bad Request)
  livestreamtaskcontro --> taskdetailpageui: return 400 Bad Request (Task must be of type Livestream)
  taskdetailpageui --> creator: Display error message: "Task must be of type Livestream"
else Livestream Idea is not yet defined
  livestreamtaskservic --> livestreamtaskcontro: throw LIVESTREAM_IDEA_REQUIRED (400 Bad Request)
  livestreamtaskcontro --> taskdetailpageui: return 400 Bad Request (Please complete Livestream Idea first)
  taskdetailpageui --> creator: Display validation warning: "Please complete Livestream Idea before drafting script"
else Empty Segments List (segments is empty)
  livestreamtaskservic --> livestreamtaskcontro: throw SCRIPT_CANNOT_BE_EMPTY (400 Bad Request)
  livestreamtaskcontro --> taskdetailpageui: return 400 Bad Request (Livestream script must contain at least one segment)
  taskdetailpageui --> creator: Display validation error: "Livestream script must contain at least one timeline segment"
else Valid Livestream Task & Segments
  livestreamtaskservic -> livestreamtaskservic: updateLivestreamScript(task, scriptRequest.getSegments())
  livestreamtaskservic -> taskrepository: save(task)
  taskrepository --> livestreamtaskservic: return savedTask
  livestreamtaskservic -> livestreamidearespon: toLivestreamScriptResponse(savedTask)
  livestreamidearespon --> livestreamtaskservic: return scriptResponse
  livestreamtaskservic --> livestreamtaskcontro: return scriptResponse
  livestreamtaskcontro --> taskdetailpageui: return 200 OK (Saved timeline segments & cues)
  taskdetailpageui --> creator: Display notification: "Livestream script saved successfully" & update timeline preview
end

@enduml
