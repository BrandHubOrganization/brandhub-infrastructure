@startuml 3.6.12 - Add Material Repository
title Sequence Diagram — 3.6.12 - Add Material Repository

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
entity "Web dashboard" as webdashboard
boundary "MaterialController" as materialcontroller
control "MaterialService" as materialservice
entity "WorkspaceRepository" as workspacerepository
entity "MaterialRepository" as materialrepository
entity "S3 storage" as s3storage
actor "CREATOR / CLIENT / MANAGER" as creatorclientmanager

' === Flow ===
materialservice -> materialservice: Check session, scope and add permission
materialservice -> materialservice: Validate file format, size and metadata
creatorclientmanager -> webdashboard: Confirm file upload (repeat per file)
webdashboard -> materialcontroller: POST /api/v1/workspaces/{workspaceId}/materials
materialcontroller -> materialservice: uploadMaterial(user, command)
materialservice -> workspacerepository: Load workspace access
workspacerepository --> materialservice: Workspace

loop invalid session / forbidden / unavailable resource
  materialservice --> materialcontroller: 401 Unauthorized / 403 Forbidden / 404 Not Found
  materialcontroller --> webdashboard: 401 Unauthorized / 403 Forbidden / 404 Not Found
  webdashboard --> creatorclientmanager: Display access or resource error
end


loop invalid input / quota exceeded
  materialservice --> materialcontroller: 400 Bad Request
  materialcontroller --> webdashboard: 400 Bad Request
  webdashboard --> creatorclientmanager: Display validation error
end

materialservice -> materialrepository: Save PENDING metadata and object key
materialrepository --> materialservice: pendingOutcome
materialservice -> s3storage: Upload file to S3
s3storage --> materialservice: storageOutcome

alt upload failed or uncertain
  materialservice -> materialrepository: Save unavailable state
  materialrepository --> materialservice: recoveryState
  materialservice --> materialcontroller: 503 Service Unavailable
  materialcontroller --> webdashboard: 503 Service Unavailable
  webdashboard --> creatorclientmanager: Display upload failure or retry status
else storage complete
  materialservice -> materialrepository: Save READY metadata
  materialrepository --> materialservice: writeOutcome
  materialservice --> materialcontroller: 201 Created
  materialcontroller --> webdashboard: 201 Created
  webdashboard --> creatorclientmanager: Display ready material in repository
end

@enduml
