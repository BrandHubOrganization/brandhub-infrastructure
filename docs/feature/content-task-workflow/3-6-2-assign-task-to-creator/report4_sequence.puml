@startuml 3.6.2 - Assign Task To Creator
title Sequence Diagram — 3.6.2 - Assign Task To Creator

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
entity "TaskRepository" as taskrepository
control "TaskService" as taskservice
boundary "TaskController" as taskcontroller
boundary "TaskDetailUI" as taskdetailui
entity "WorkspaceMemberRepository" as workspacememberrepos
actor "Manager" as manager

' === Flow ===
manager -> taskdetailui: clicks "Assign Task" button on task detail page
taskdetailui -> taskcontroller: GET /api/v1/workspaces/{workspaceId}/members?role=MEMBER
taskcontroller -> taskservice: listAssignableMembers(workspaceId)
taskservice -> workspacememberrepos: findAllByWorkspaceIdAndStatusActive(workspaceId)
workspacememberrepos --> taskservice: activeMemberList
taskservice --> taskcontroller: List<WorkspaceMemberResponse>
taskcontroller --> taskdetailui: 200 OK (activeMemberList)
taskdetailui --> manager: render Assign dialog (assignee dropdown, QC dropdown, requireClientApproval toggle)
manager ->> taskdetailui: selects assigneeId, optional qcAssigneeId, toggles requiresClientApproval & submits
taskdetailui ->> taskcontroller: POST /api/v1/workspaces/{workspaceId}/tasks/{taskId}/assign (AssignTaskRequest)
taskcontroller ->> taskservice: assignTask(workspaceId, taskId, currentUser, request)
taskservice ->> taskrepository: findByIdAndWorkspaceId(taskId, workspaceId)
taskrepository --> taskservice: task

alt caller is not manager of workspace
  taskservice --> taskcontroller: throw BusinessException (403 FORBIDDEN)
  taskdetailui --> manager: show access denied error toast
  taskcontroller --> taskdetailui: 403 Forbidden
else task status is not DETAIL_IDENTIFIED
  taskservice --> taskcontroller: throw BusinessException (409 TASK_DETAIL_NOT_IDENTIFIED)
  taskdetailui --> manager: show error alert ("Task must be in DETAIL_IDENTIFIED status before assignment")
  taskcontroller --> taskdetailui: 409 Conflict
else qcAssigneeId equals assigneeId
  taskservice --> taskcontroller: throw BusinessException (400 QC_CANNOT_BE_SAME_AS_ASSIGNEE)
  taskdetailui --> manager: show validation error ("Assignee cannot be assigned to QC their own task")
  taskcontroller --> taskdetailui: 400 Bad Request
else assigneeId is not an active workspace member
  taskservice ->> workspacememberrepos: findByWorkspaceIdAndUserId(workspaceId, assigneeId)
  workspacememberrepos --> taskservice: empty
  taskservice --> taskcontroller: throw BusinessException (400 INVALID_ASSIGNEE)
  taskcontroller --> taskdetailui: 400 Bad Request
  taskdetailui --> manager: show validation error ("Selected assignee is not an active workspace member")
else valid assignment
  taskservice ->> workspacememberrepos: findByWorkspaceIdAndUserId(workspaceId, assigneeId)
  workspacememberrepos --> taskservice: assigneeMember
end


opt qcAssigneeId is present
  taskservice ->> workspacememberrepos: findByWorkspaceIdAndUserId(workspaceId, qcAssigneeId)
  workspacememberrepos --> taskservice: qcMember
end

else valid assignment
  taskservice ->> taskrepository: save(task with assigneeId, qcAssigneeId, requiresClientApproval, status=ASSIGNED)
  taskrepository --> taskservice: savedTask
  taskservice --> taskcontroller: TaskResponse (status=ASSIGNED)
  taskcontroller --> taskdetailui: 200 OK (TaskResponse)
  taskdetailui --> manager: show success toast ("Task assigned successfully") & update status badge to ASSIGNED
end

@enduml
