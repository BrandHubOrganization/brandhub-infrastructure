@startuml 3.7.9 - Configure trend crawling
title Sequence Diagram — 3.7.9 - Configure trend crawling

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
entity "System Administrator" as systemadministrator
boundary "AdminCrawlConfigPanel (UI)" as admincrawlconfigpane
boundary "AdminCrawlConfigController" as admincrawlconfigcont
control "AdminCrawlConfigService" as admincrawlconfigserv
control "AdminAccountService" as adminaccountservice
entity "UserSystemRoleRepository" as usersystemrolereposi
control "AI Service (trends API)" as aiservicetrendsapi

' === Flow ===
admincrawlconfigpane -> admincrawlconfigcont: GET/PATCH /admin/ai/crawl-config Or GET/POST /admin/ai/crawl-runs
activate admincrawlconfigcont
activate systemadministrator
systemadministrator -> admincrawlconfigpane: View settings/history, save, or crawl now
admincrawlconfigcont -> admincrawlconfigserv: get(actor) / runs(actor) / update(actor, request) / runNow(actor)
activate admincrawlconfigserv
admincrawlconfigserv -> adminaccountservice: requireAdmin(actor)
activate adminaccountservice
adminaccountservice -> usersystemrolereposi: findByUserId(actor)
activate usersystemrolereposi
usersystemrolereposi --> adminaccountservice: Optional<UserSystemRole>
deactivate usersystemrolereposi
adminaccountservice --> admincrawlconfigserv: ADMIN verified (void) / FORBIDDEN
deactivate adminaccountservice

alt Actor is not ADMIN
  admincrawlconfigserv --> admincrawlconfigcont: FORBIDDEN
  deactivate admincrawlconfigserv
  admincrawlconfigcont --> admincrawlconfigpane: 403 — access denied
  deactivate admincrawlconfigcont
  admincrawlconfigpane --> systemadministrator: Show access error
else ADMIN permission granted
  activate admincrawlconfigcont
  activate admincrawlconfigserv
  admincrawlconfigserv -> aiservicetrendsapi: GET /api/v1/ai/trends/crawl-config Or /api/v1/ai/trends/crawl-runs
  activate aiservicetrendsapi
  aiservicetrendsapi --> admincrawlconfigserv: Current config/run data or AI error
  deactivate aiservicetrendsapi
end


opt Current data loaded; saving settings
  admincrawlconfigserv -> admincrawlconfigserv: Validate schedule, source URLs and limits
end


opt Data loaded; valid save OR idle crawl request
  admincrawlconfigserv -> aiservicetrendsapi: POST /api/v1/ai/trends/crawl-config Or /api/v1/ai/trends/crawl-runs
  activate aiservicetrendsapi
  aiservicetrendsapi --> admincrawlconfigserv: Saved config / accepted run / AI error
  deactivate aiservicetrendsapi
end


alt Invalid input, crawl conflict or AI failure
  admincrawlconfigserv --> admincrawlconfigcont: BusinessException / AiServiceException
  deactivate admincrawlconfigserv
  admincrawlconfigcont --> admincrawlconfigpane: 400 / 409 / 502 / 503 — request failed
  deactivate admincrawlconfigcont
  admincrawlconfigpane --> systemadministrator: Show error; keep the input
end
activate admincrawlconfigcont
activate admincrawlconfigserv


opt Settings saved or new run accepted
  admincrawlconfigserv -> admincrawlconfigserv: Record the admin audit
end

else Selected operation succeeded
  admincrawlconfigserv --> admincrawlconfigcont: ObjectNode — selected operation result
  deactivate admincrawlconfigserv
  admincrawlconfigcont --> admincrawlconfigpane: 200 OK / 202 Accepted
  deactivate admincrawlconfigcont
  admincrawlconfigpane --> systemadministrator: Show settings, history or new run
end

deactivate systemadministrator
@enduml