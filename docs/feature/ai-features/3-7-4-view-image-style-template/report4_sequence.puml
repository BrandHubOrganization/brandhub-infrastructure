@startuml 3.7.4 - View Image Style Template
title Sequence Diagram — 3.7.4 - View Image Style Template

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
control "AiServiceClient" as aiserviceclient
entity "AiMicroservice" as aimicroservice
boundary "AiGenerationController" as aigenerationcontroll
boundary "ImageGeneratorUI" as imagegeneratorui
actor "Creator" as creator

' === Flow ===
imagegeneratorui -> aigenerationcontroll: GET /api/v1/ai/image-style-templates?category={category}
activate aigenerationcontroll
creator -> imagegeneratorui: opens generator studio & browses style gallery (filters by category: food, cosmetics, fashion, tech, living)
activate imagegeneratorui
aigenerationcontroll -> aiserviceclient: get("/api/v1/ai/templates?category=" + category)
activate aiserviceclient
aiserviceclient -> aimicroservice: GET /api/v1/ai/templates?category={category} (header: X-Internal-Key)
activate aimicroservice

alt templates retrieved successfully
  aimicroservice --> aiserviceclient: 200 OK (TemplateListResponse: master templates catalog, thumbnails, presets)
  deactivate aimicroservice
  aiserviceclient --> aigenerationcontroll: JsonNode (templates)
  deactivate aiserviceclient
  aigenerationcontroll --> imagegeneratorui: 200 OK (List<ImageStyleTemplateResponse>)
  deactivate aigenerationcontroll
  imagegeneratorui --> creator: render style template cards (thumbnail preview, category badge, sample prompt, aspect ratio)
else AI microservice unavailable or timeout
  activate aigenerationcontroll
  activate aiserviceclient
  activate aimicroservice
  aimicroservice --> aiserviceclient: 503 Service Unavailable / Connection Timeout
  deactivate aimicroservice
  aiserviceclient --> aigenerationcontroll: throw AiServiceException (503 SERVICE_UNAVAILABLE)
  deactivate aiserviceclient
  aigenerationcontroll --> imagegeneratorui: 503 Service Unavailable (AI_SERVICE_UNAVAILABLE)
  deactivate aigenerationcontroll
  imagegeneratorui --> creator: show error toast ('Unable to load style templates, please retry')
end
activate aigenerationcontroll
activate aiserviceclient
activate aimicroservice

creator ->> imagegeneratorui: selects template card (e.g. 'Traditional Vietnamese Iced Coffee')
aigenerationcontroll ->> aiserviceclient: get("/api/v1/ai/templates/" + templateId)
imagegeneratorui ->> aigenerationcontroll: GET /api/v1/ai/image-style-templates/{templateId}
aiserviceclient ->> aimicroservice: GET /api/v1/ai/templates/{templateId} (header: X-Internal-Key)

alt template found
  aimicroservice --> aiserviceclient: 200 OK (PromptTemplate: style tokens, recommended CFG, steps, aspect ratio)
  deactivate aimicroservice
  aiserviceclient --> aigenerationcontroll: JsonNode (template detail)
  deactivate aiserviceclient
  aigenerationcontroll --> imagegeneratorui: 200 OK (ImageStyleTemplateDetailResponse)
  deactivate aigenerationcontroll
  imagegeneratorui --> creator: apply template settings to form (base prompt, style preset, recommended aspect ratio & camera angle)
else template not found
  activate aiserviceclient
  activate aigenerationcontroll
  activate aimicroservice
  aimicroservice --> aiserviceclient: 404 Not Found (detail: 'Template not found')
  deactivate aimicroservice
  aiserviceclient --> aigenerationcontroll: throw AiServiceException (404 NOT_FOUND)
  deactivate aiserviceclient
  aigenerationcontroll --> imagegeneratorui: 404 Not Found (TEMPLATE_NOT_FOUND)
  deactivate aigenerationcontroll
  imagegeneratorui --> creator: show error toast ('Style template not found')
  deactivate imagegeneratorui
end

@enduml