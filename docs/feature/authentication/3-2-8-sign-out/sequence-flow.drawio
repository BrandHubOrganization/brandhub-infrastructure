 as="geometry"><mxPoint x="80" y="130" as="sourcePoint"/><mxPoint x="300" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_7" value="POST /api/v1/auth/logout (Bearer, Cookie refreshToken)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="180" as="sourcePoint"/><mxPoint x="520" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note_8" value="opt: thiếu/sai prefix Bearer -&gt; 401 INVALID_CREDENTIALS (response.setStatus, không throw BusinessException)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="720" height="26" as="geometry"/></mxCell><mxCell id="msg_9" value="parseToken(accessToken)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="280" as="sourcePoint"/><mxPoint x="520" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note_10" value="opt: token hết hạn/invalid -&gt; bắt JwtException, bỏ qua (idempotent, userId=null)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="720" height="26" as="geometry"/></mxCell><mxCell id="msg_11" value="blacklist accessToken jti (Redis)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="380" as="sourcePoint"/><mxPoint x="740" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_12" value="blacklist refreshToken jti nếu có (Redis)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="430" as="sourcePoint"/><mxPoint x="740" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note_13" value="opt: có userId hợp lệ -&gt; ghi audit log (userId/action LOGOUT); lưu kèm ipAddress (X-Forwarded-For) + userAgent (User-Agent) vào audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="720" height="26" as="geometry"/></mxCell><mxCell id="msg_14" value="INSERT audit_logs (userId, LOGOUT, USER, ipAddress, userAgent) nếu userId != null" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="530" as="sourcePoint"/><mxPoint x="740" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_15" value="200 { success:true, data:null } + Set-Cookie refreshToken=&quot;&quot; maxAge=0" style="html=1;endArrow=block;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="580" as="sourcePoint"/><mxPoint x="300" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_16" value="xóa accessToken khỏi store, ghi lastUsedLoginMethod vào localStorage" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="630" as="sourcePoint"/><mxPoint x="300" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_17" value="redirect /login, hiển thị badge phương thức lần trước" style="html=1;endArrow=block;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="680" as="sourcePoint"/><mxPoint x="80" y="680" as="targetPoint"/></mxGeometry></mxCell>
