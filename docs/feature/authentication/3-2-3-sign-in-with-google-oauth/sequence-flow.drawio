ck;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="380" as="sourcePoint"/><mxPoint x="740" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_13" value="302 -&gt; GET /oauth/google/callback?code=...&amp;state=..." style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="430" as="sourcePoint"/><mxPoint x="520" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_14" value="Redis GETDEL oauth:state:{state} -&gt; khong co/provider sai =&gt; OAUTH_STATE_INVALID" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="480" as="sourcePoint"/><mxPoint x="960" y="480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_15" value="POST /token (form-urlencoded: code, client_id, client_secret, redirect_uri, grant_type)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="530" as="sourcePoint"/><mxPoint x="740" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_16" value="access_token (null =&gt; OAUTH_CODE_INVALID)" style="html=1;endArrow=block;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="580" as="sourcePoint"/><mxPoint x="520" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_17" value="GET /userinfo (Bearer access_token)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="630" as="sourcePoint"/><mxPoint x="740" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_18" value="{id, email, verified_email, name, picture} (thieu email/verified_email!=true =&gt; OAUTH_CODE_INVALID)" style="html=1;endArrow=block;dashed=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="680" as="sourcePoint"/><mxPoint x="520" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_19" value="Tim user_oauth_providers(GOOGLE, providerId); neu khong co -&gt; tim User theo email, chua co thi INSERT users(emailVerifiedAt=now) + user_system_roles(USER); luon INSERT user_oauth_providers" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="730" as="sourcePoint"/><mxPoint x="960" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note_20" value="Check user.isActive() / status=ACTIVE, sai =&gt; 403 ACCOUNT_SUSPENDED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="780" width="940" height="26" as="geometry"/></mxCell><mxCell id="note_21" value="Neu twoFactorEnabled=true (Flow C): sinh twoFactorToken, 302 redirect {FRONTEND_URL}/2fa-verify?twoFactorToken=..., KHONG cap accessToken/refreshToken o day, dung lai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="830" width="940" height="26" as="geometry"/></mxCell><mxCell id="msg_22" value="UPDATE users.lastLoginAt, INSERT audit_logs(LOGIN)" style="html=1;endArrow=block;dashed=0;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="880" as="sourcePoint"/><mxPoint x="960" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg_23" value="302 Redirect {FRONTEND_URL}/oauth-callback#token={accessToken} + Set-Cookie refreshToken(HttpOnly/Secure/SameSite=Strict)" style="html=1;