@startuml 3.10.6 - Search users and view strike history
title Sequence Diagram — 3.10.6 - Search users and view strike history

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
entity "System Administrator" as systemadministrator
boundary "AdminAccountsPanel / AdminStrikeDialog (UI)" as adminaccountspanelad
boundary "AdminController" as admincontroller
control "AdminAccountQueryService" as adminaccountqueryser
control "AdminAccountService" as adminaccountservice
entity "UserRepository" as userrepository
entity "UserStrikeRepository" as userstrikerepository
entity "SanctionReviewRepository" as sanctionreviewreposi
entity "User / UserStrike" as useruserstrike

' === Flow ===
adminaccountspanelad -> admincontroller: GET /api/v1/admin/users OR /users/{id}/violations
admincontroller -> adminaccountqueryser: list(actor, filter) / history(actor, userId, page)
adminaccountqueryser -> adminaccountqueryser: Validate filters and pagination
systemadministrator -> adminaccountspanelad: Search accounts or view strike history
adminaccountqueryser -> adminaccountservice: requireAdmin(actor)
adminaccountservice --> adminaccountqueryser: ADMIN verified (void) / BusinessException(FORBIDDEN)
adminaccountqueryser --> admincontroller: BusinessException(errorCode)
admincontroller --> adminaccountspanelad: 403 / 400 — request rejected
adminaccountspanelad --> systemadministrator: Show the error; keep filters

alt Search accounts
  adminaccountqueryser -> userrepository: findAdminUsers(search, status, role, pageable)
  userrepository --> adminaccountqueryser: Page<User>, including an empty page
else View strike history
  adminaccountqueryser -> userrepository: findById(userId)
  userrepository --> adminaccountqueryser: Optional<User>
end


alt History account not found
  adminaccountqueryser --> admincontroller: BusinessException(USER_NOT_FOUND)
  admincontroller --> adminaccountspanelad: 404 — account not found
end

adminaccountspanelad --> systemadministrator: Show the error; return to account list

opt Viewing strike history
  adminaccountqueryser -> userstrikerepository: findByUserIdOrderByCreatedAtDescIdDesc(userId, pageable)
  userstrikerepository --> adminaccountqueryser: Page<UserStrike>
end


opt Returned account list is not empty
  adminaccountqueryser -> useruserstrike: Read account and strike fields
  useruserstrike --> adminaccountqueryser: Account IDs/status and history fields
  adminaccountqueryser -> sanctionreviewreposi: findByUserIdInAndStatus(userIds, "PENDING")
  sanctionreviewreposi --> adminaccountqueryser: Pending sanction reviews
  adminaccountqueryser -> userstrikerepository: findByUserIdInAndRemovedAtIsNullAndExpiresAtAfter (userIds, now)
  userstrikerepository --> adminaccountqueryser: Live strikes for counters
end

adminaccountqueryser --> admincontroller: AdminPageResponse<AdminUserResponse> / AdminStrikeSummary
admincontroller --> adminaccountspanelad: 200 OK — includes valid empty pages
adminaccountspanelad --> systemadministrator: Show accounts, counters, history and pagination

@enduml
