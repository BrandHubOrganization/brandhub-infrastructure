@startuml 3.10.8 - Update user profile and next-period plan request
title Sequence Diagram — 3.10.8 - Update user profile and next-period plan request

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Admin" as admin
boundary "EditUserDialog (UI)" as edituserdialogui
boundary "AdminUserController" as adminusercontroller
control "AdminUserProvisioningService" as adminuserprovisionin
control "AdminAccountService" as adminaccountservice
entity "UserRepository" as userrepository

' === Flow ===
admin -> edituserdialogui: Submit profile / plan update request
edituserdialogui -> adminusercontroller: PATCH /api/v1/admin/users/{id}(request)
adminusercontroller -> adminaccountservice: requireAdmin(actorId)
adminaccountservice --> adminusercontroller: 200 OK (ADMIN verified)
adminusercontroller -> adminuserprovisionin: updateUserProfileAndPlan(userId, request)
adminuserprovisionin -> userrepository: findById(userId)
userrepository --> adminuserprovisionin: return Optional<UserEntity>

alt User exists
  adminuserprovisionin -> userrepository: save(updatedUser)
  userrepository --> adminuserprovisionin: return savedUser
  adminuserprovisionin --> adminusercontroller: return UserUpdateResponse
  adminusercontroller --> edituserdialogui: 200 OK (UserUpdateResponse)
  edituserdialogui --> admin: Display success notification
else User not found
  adminuserprovisionin --> adminusercontroller: 404 Not Found (UserNotFoundException)
  adminusercontroller --> edituserdialogui: 404 Not Found (ErrorResponse)
  edituserdialogui --> admin: Show error notification
end

@enduml
