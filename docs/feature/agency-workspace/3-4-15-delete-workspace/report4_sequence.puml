@startuml 3.4.15 - Delete Workspace
title Sequence Diagram — 3.4.15 - Delete Workspace

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Agency Owner" as agency_owner
boundary "WorkspaceDetailPage danger zone (UI)" as workspacedetailpage_danger_zone_ui
boundary "WorkspaceController" as workspacecontroller
control "WorkspaceServiceImpl" as workspaceserviceimpl
entity "WorkspaceRepository" as workspacerepository
entity "AgencyRepository" as agencyrepository
entity "Workspace" as workspace
entity "WorkspaceResponse" as workspaceresponse

alt deletes workspace
  agency_owner -> workspacedetailpage_danger_zone_ui: confirms delete
  workspacedetailpage_danger_zone_ui -> workspacecontroller: DELETE /api/v1/workspaces/{workspaceId}
  workspacecontroller -> workspaceserviceimpl: deleteWorkspace(currentUser, workspaceId)
  workspaceserviceimpl -> workspacerepository: findById(workspaceId)
  workspacerepository --> workspaceserviceimpl: Optional<Workspace>
  opt !workspace.present
    workspaceserviceimpl --> workspacecontroller: throw 404 WORKSPACE_NOT_FOUND
    workspacecontroller --> workspacedetailpage_danger_zone_ui: 404 Not Found
    workspacedetailpage_danger_zone_ui --> agency_owner: shows 404 toast
  end
  workspaceserviceimpl -> workspace: getAgencyId()
  workspace --> workspaceserviceimpl: agencyId
  workspaceserviceimpl -> agencyrepository: findById(agencyId)
  agencyrepository --> workspaceserviceimpl: Optional<Agency>
  opt !agency.present
    workspaceserviceimpl --> workspacecontroller: throw 404 AGENCY_NOT_FOUND
    workspacecontroller --> workspacedetailpage_danger_zone_ui: 404 Not Found
    workspacedetailpage_danger_zone_ui --> agency_owner: shows 404 toast
  end
  opt caller not Owner
    workspaceserviceimpl --> workspacecontroller: throw 403 FORBIDDEN
    workspacecontroller --> workspacedetailpage_danger_zone_ui: 403 Forbidden
    workspacedetailpage_danger_zone_ui --> agency_owner: shows 403 toast
  end
  workspaceserviceimpl -> workspace: setStatus(SOFT_DELETED)
  workspace --> workspaceserviceimpl: Workspace
  workspaceserviceimpl -> workspacerepository: save(workspace)
  workspacerepository --> workspaceserviceimpl: Workspace
  workspaceserviceimpl --> workspacecontroller: 200 OK
  workspacecontroller --> workspacedetailpage_danger_zone_ui: 200 OK
  workspacedetailpage_danger_zone_ui --> agency_owner: shows 200 toast
else restores workspace
  agency_owner -> workspacedetailpage_danger_zone_ui: clicks Restore Workspace
  workspacedetailpage_danger_zone_ui -> workspacecontroller: POST /api/v1/workspaces/{workspaceId}/restore
  workspacecontroller -> workspaceserviceimpl: restoreWorkspace(currentUser, workspaceId)
  workspaceserviceimpl -> workspacerepository: findById(workspaceId)
  workspacerepository --> workspaceserviceimpl: Optional<Workspace>
  opt !workspace.present
    workspaceserviceimpl --> workspacecontroller: throw 404 WORKSPACE_NOT_FOUND
    workspacecontroller --> workspacedetailpage_danger_zone_ui: 404 Not Found
    workspacedetailpage_danger_zone_ui --> agency_owner: shows 404 toast
  end
  workspaceserviceimpl -> workspace: getAgencyId()
  workspace --> workspaceserviceimpl: agencyId
  workspaceserviceimpl -> agencyrepository: findById(agencyId)
  agencyrepository --> workspaceserviceimpl: Optional<Agency>
  opt !agency.present
    workspaceserviceimpl --> workspacecontroller: throw 404 AGENCY_NOT_FOUND
    workspacecontroller --> workspacedetailpage_danger_zone_ui: 404 Not Found
    workspacedetailpage_danger_zone_ui --> agency_owner: shows 404 toast
  end
  opt caller not Owner
    workspaceserviceimpl --> workspacecontroller: throw 403 FORBIDDEN
    workspacecontroller --> workspacedetailpage_danger_zone_ui: 403 Forbidden
    workspacedetailpage_danger_zone_ui --> agency_owner: shows 403 toast
  end
  workspaceserviceimpl -> workspace: setStatus(ACTIVE)
  workspace --> workspaceserviceimpl: Workspace
  workspaceserviceimpl -> workspacerepository: save(workspace)
  workspacerepository --> workspaceserviceimpl: Workspace
  workspaceserviceimpl -> workspaceresponse: toResponse(workspace)
  workspaceresponse --> workspaceserviceimpl: WorkspaceResponse
  workspaceserviceimpl --> workspacecontroller: WorkspaceResponse
  workspacecontroller --> workspacedetailpage_danger_zone_ui: 200 OK WorkspaceResponse
  workspacedetailpage_danger_zone_ui --> agency_owner: shows 200 toast
end

@enduml