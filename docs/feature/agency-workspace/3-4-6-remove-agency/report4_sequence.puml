@startuml 3.4.6 - Remove Agency
title Sequence Diagram — 3.4.6 - Remove Agency

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Owner" as owner
boundary "AgencySettingsPage (UI)" as agencysettingspage_ui
boundary "AgencyController" as agencycontroller
control "AgencyServiceImpl" as agencyserviceimpl
entity "AgencyRepository" as agencyrepository
entity "Agency" as agency
entity "WorkspaceRepository" as workspacerepository

' === Flow ===
owner -> agencysettingspage_ui: selects Remove on Agency settings, confirms
agencysettingspage_ui -> agencycontroller: DELETE /api/v1/agencies/{agencyId}
agencycontroller -> agencyserviceimpl: removeAgency(agencyId, currentUser)
alt !agency.present
  agencyserviceimpl -> agencyrepository: findById(agencyId)
  agencyrepository --> agencyserviceimpl: Optional.empty()
  agencyserviceimpl --> agencycontroller: throw AGENCY_NOT_FOUND (404)
  agencycontroller --> agencysettingspage_ui: 404 AGENCY_NOT_FOUND
  agencysettingspage_ui --> owner: shows 404 toast
else agency.present
  agencyserviceimpl -> agencyrepository: findById(agencyId)
  agencyrepository --> agencyserviceimpl: Optional<Agency>
  agencyserviceimpl -> agency: getOwnerId()
  agency --> agencyserviceimpl: ownerId
  opt caller != OWNER
    agencyserviceimpl --> agencycontroller: throw NOT_AGENCY_OWNER (403)
    agencycontroller --> agencysettingspage_ui: 403 NOT_AGENCY_OWNER
    agencysettingspage_ui --> owner: shows 403 toast
  end
  agencyserviceimpl -> agency: setStatus(SOFT_DELETED)
  agency --> agencyserviceimpl: Agency
  agencyserviceimpl -> agencyrepository: save(agency)
  agencyrepository --> agencyserviceimpl: Agency
  agencyserviceimpl -> workspacerepository: findByAgencyId(agencyId)
  workspacerepository --> agencyserviceimpl: List<Workspace>
  agencyserviceimpl -> agencyserviceimpl: softDeleteWorkspaces(agencyId)
  agencyserviceimpl -> workspacerepository: saveAll(workspaces)
  agencyserviceimpl --> agencycontroller: 204 No Content
  agencycontroller --> agencysettingspage_ui: 204 No Content
  agencysettingspage_ui --> owner: shows confirmation, updates screen
end

@enduml