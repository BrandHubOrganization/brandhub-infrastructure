WorkspaceServiceImpl ..> WorkspaceMediaPackageRepository : uses
WorkspaceServiceImpl ..> AgencyRepository : uses
WorkspaceServiceImpl ..> AgencyMemberRepository : uses
WorkspaceServiceImpl ..> UserRepository : uses
WorkspaceServiceImpl ..> ClientProfileRepository : uses

WorkspaceTemplateServiceImpl ..> WorkspaceTemplateRepository : uses
