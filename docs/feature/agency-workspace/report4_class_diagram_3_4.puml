' REPOSITORY LAYER
' ==========================================================
package "com.brandhub.business.repository" {
    interface AgencyRepository <<repository>> {
        + findById(id: UUID): Optional<Agency>
        + save(agency: Agency): Agency
        + findByOwnerId(ownerId: UUID): List<Agency>
        + findByOwnerIdAndStatusNot(ownerId: UUID, status: EntityStatus): List<Agency>
    }

    interface AgencyMemberRepository <<repository>> {
        + findByAgencyId(agencyId: UUID): List<AgencyMember>
        + findByAgencyIdAndUserId(agencyId: UUID, userId: UUID): Optional<AgencyMember>
        + findByUserId(userId: UUID): List<AgencyMember>
        + save(member: AgencyMember): AgencyMember
        + delete(member: AgencyMember): void
    }

    interface AgencyInvitationRepository <<repository>> {
        + findByAgencyId(agencyId: UUID): List<AgencyInvitation>
        + findByToken(token: String): Optional<AgencyInvitation>
        + findByAgencyIdAndInvitedEmailAndStatusAndExpiresAtAfter(agencyId: UUID, email: String, status: InvitationStatus, now: OffsetDateTime): Optional<AgencyInvitation>
        + findByInvitedEmailAndStatus(email: String, status: InvitationStatus): List<AgencyInvitation>
        + countByAgencyIdAndStatusAndExpiresAtAfter(agencyId: UUID, status: InvitationStatus, now: OffsetDateTime): long
    }

    interface WorkspaceRepository <<repository>> {
        + findById(id: UUID): Optional<Workspace>
        + findByIdForUpdate(id: UUID): Optional<Workspace>
        + findByAgencyId(agencyId: UUID): List<Workspace>
        + save(workspace: Workspace): Workspace
    }

    interface WorkspaceMemberRepository <<repository>> {
        + findByWorkspaceIdAndUserIdAndIsActiveTrue(workspaceId: UUID, userId: UUID): Optional<WorkspaceMember>
        + findByWorkspaceIdAndClientProfileIdAndIsActiveTrue(workspaceId: UUID, clientProfileId: UUID): Optional<WorkspaceMember>
        + findByWorkspaceIdAndIsActiveTrue(workspaceId: UUID): List<WorkspaceMember>
        + findByUserIdAndIsActiveTrue(userId: UUID): List<WorkspaceMember>
        + findByClientProfileIdInAndIsActiveTrue(clientProfileIds: List<UUID>): List<WorkspaceMember>
        + countByWorkspaceIdAndRoleAndIsActiveTrue(workspaceId: UUID, role: MemberRole): long
        + countByWorkspaceIdAndIsActiveTrue(workspaceId: UUID): long
    }

    interface WorkspaceInvitationRepository <<repository>> {
        + findByWorkspaceIdAndInvitedEmailAndStatus(workspaceId: UUID, email: String, status: InvitationStatus): Optional<WorkspaceInvitation>
        + findByWorkspaceIdAndInvitedEmailAndStatusAndExpiresAtAfter(workspaceId: UUID, email: String, status: InvitationStatus, now: OffsetDateTime): Optional<WorkspaceInvitation>
        + findByInvitedEmailAndStatus(email: String, status: InvitationStatus): List<WorkspaceInvitation>
        + findByToken(token: String): Optional<WorkspaceInvitation>
    }

    interface WorkspaceTemplateRepository <<repository>> {
        + findByAgencyId(agencyId: UUID): List<WorkspaceTemplate>
        + findByAgencyIdOrAgencyIdIsNull(agencyId: UUID): List<WorkspaceTemplate>
        + save(template: WorkspaceTemplate): WorkspaceTemplate
        + delete(template: WorkspaceTemplate): void
    }

    interface WorkspaceMediaPackageRepository <<repository>> {
        + findByWorkspaceId(workspaceId: UUID): Optional<WorkspaceMediaPackage>
        + findByWorkspaceIdForUpdate(workspaceId: UUID): Optional<WorkspaceMediaPackage>
    }
}

