@startuml 3.8.12 - Publish Instagram Reels (Short/Long Video)
title Sequence Diagram — 3.8.12 - Publish Instagram Reels (Short/Long Video)

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Scheduler (Job)" as schedulerjob
control "SchedulerService" as schedulerservice
entity "RabbitMQ" as rabbitmq
entity "PublishJobConsumer" as publishjobconsumer
control "InstagramReelsPublishService" as instagramreelspublis
entity "Meta Graph API" as metagraphapi
entity "PostRepository" as postrepository

' === Flow ===
schedulerjob -> schedulerservice: trigger scheduled publish job
schedulerservice -> postrepository: findScheduledPosts(scheduledAt <= NOW(), platform=INSTAGRAM, type=REELS)
postrepository --> schedulerservice: List<Post>
schedulerservice -> rabbitmq: publish("publisher.job.queue", PublishJobMessage{platform=INSTAGRAM, type=REELS, ...})
rabbitmq --> publishjobconsumer: consume(PublishJobMessage)
publishjobconsumer -> instagramreelspublis: publishPost(jobMessage)
instagramreelspublis -> metagraphapi: POST /{igUserId}/media (media_type="REELS", video_url, caption, share_to_feed=true)
metagraphapi --> instagramreelspublis: {id: containerId}
instagramreelspublis -> metagraphapi: GET /{containerId}?fields=status_code (poll until FINISHED)
metagraphapi --> instagramreelspublis: {status_code: FINISHED}
instagramreelspublis -> metagraphapi: POST /{igUserId}/media_publish (creation_id=containerId)
metagraphapi --> instagramreelspublis: {id: platformPostId}

alt publish failed
  instagramreelspublis --> publishjobconsumer: FAILED (error)
  publishjobconsumer -> rabbitmq: basicNack -> Route to DLQ
  publishjobconsumer -> postrepository: update(post, status=FAILED)
  postrepository --> publishjobconsumer: ok
else publish success
  instagramreelspublis --> publishjobconsumer: SUCCESS (platformPostId)
  publishjobconsumer -> postrepository: update(post, status=PUBLISHED, platformPostId)
  postrepository --> publishjobconsumer: ok
end

@enduml
