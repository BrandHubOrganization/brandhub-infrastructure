@startuml 3.8.10 - Publish Facebook Reels (Video)
title Sequence Diagram — 3.8.10 - Publish Facebook Reels (Video)

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam BoxPadding 10
skinparam ParticipantPadding 10

' === Participants ===
actor "Scheduler (Job)" as schedulerjob
control "SchedulerService" as schedulerservice
entity "RabbitMQ" as rabbitmq
entity "PublishJobConsumer" as publishjobconsumer
control "FacebookPublishService" as facebookpublishservi
entity "Meta Graph API" as metagraphapi
entity "PostRepository" as postrepository

' === Flow ===
schedulerjob -> schedulerservice: trigger scheduled publish job
activate schedulerservice
schedulerservice -> postrepository: findScheduledPosts(scheduledAt <= NOW(), platform=FACEBOOK, type=REELS)
activate postrepository
postrepository --> schedulerservice: List<Post>
deactivate postrepository
schedulerservice -> rabbitmq: publish("publisher.job.queue", PublishJobMessage{platform=FACEBOOK, type=REELS, ...})
activate rabbitmq
rabbitmq --> publishjobconsumer: consume(PublishJobMessage)
deactivate rabbitmq
activate publishjobconsumer
publishjobconsumer -> facebookpublishservi: publishPost(jobMessage)
activate facebookpublishservi
facebookpublishservi -> metagraphapi: POST /{pageId}/videos (video_url, title, published=true)
activate metagraphapi
metagraphapi --> facebookpublishservi: {id: videoId, status: PROCESSING}
deactivate metagraphapi

alt publish failed
  facebookpublishservi --> publishjobconsumer: FAILED (error)
  deactivate facebookpublishservi
  publishjobconsumer -> rabbitmq: basicNack -> Route to DLQ
  activate rabbitmq
  publishjobconsumer -> postrepository: update(post, status=FAILED)
  activate postrepository
  postrepository --> publishjobconsumer: ok
  deactivate postrepository
else publish success
  activate facebookpublishservi
  facebookpublishservi --> publishjobconsumer: SUCCESS (platformPostId)
  deactivate facebookpublishservi
  publishjobconsumer -> postrepository: update(post, status=PUBLISHED, platformPostId)
  activate postrepository
  postrepository --> publishjobconsumer: ok
  deactivate postrepository
  publishjobconsumer -> rabbitmq: publish("business.publish_callback.queue", CallbackMessage{status=SUCCESS})
end

deactivate rabbitmq
deactivate schedulerservice
deactivate publishjobconsumer
@enduml