@startuml 3.8.1b - Connect TikTok Account (PKCE Flow)
title Sequence Diagram — 3.8.1b - Connect TikTok Account (PKCE Flow)

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

' === Participants ===
actor "User" as user
boundary "SocialAccountsPage (UI)" as ui
boundary "SocialOAuthController" as ctrl
control "TikTokOAuthService" as oauthSvc
entity "SocialAccountService" as accountSvc
entity "TikTok Open API" as tiktokApi

' === Flow ===
user -> ui: clicks "Connect TikTok"
activate ui
ui -> ctrl: GET /api/v1/oauth/social/connect?platform=TIKTOK
activate ctrl
ctrl -> oauthSvc: buildAuthorizationUrl()
activate oauthSvc
oauthSvc --> ctrl: authUrl (with PKCE code_challenge)
deactivate oauthSvc
ctrl --> ui: 302 Redirect to authUrl
deactivate ctrl
ui --> user: TikTok Authorization Screen

user -> tiktokApi: authorizes permissions
activate tiktokApi
tiktokApi --> ui: callback with authCode & state
deactivate tiktokApi

ui -> ctrl: GET /api/v1/oauth/social/callback?code=authCode&state=...
activate ctrl
ctrl -> oauthSvc: exchangeToken(authCode, codeVerifier)
activate oauthSvc
oauthSvc -> tiktokApi: exchange token with code verifier
activate tiktokApi
tiktokApi --> oauthSvc: accessToken + refreshToken
deactivate tiktokApi
oauthSvc -> tiktokApi: fetch TikTok profile info
activate tiktokApi
tiktokApi --> oauthSvc: userInfo(displayName, avatarUrl)
deactivate tiktokApi

alt connection failed
  oauthSvc --> ctrl: 302 Redirect with error status
  deactivate oauthSvc
  ctrl --> ui: error redirect
  deactivate ctrl
  ui --> user: Show error "TikTok connection cancelled or failed"
else connection success
  activate oauthSvc
  activate ctrl
  oauthSvc -> accountSvc: syncSocialAccount(userId, userInfo, encryptedToken)
  activate accountSvc
  accountSvc --> oauthSvc: savedAccount
  deactivate accountSvc
  oauthSvc --> ctrl: 302 Redirect with success status
  deactivate oauthSvc
  ctrl --> ui: redirect to SocialAccountsPage
  deactivate ctrl
  ui --> user: Show TikTok channel card as connected
  deactivate ui
end

@enduml