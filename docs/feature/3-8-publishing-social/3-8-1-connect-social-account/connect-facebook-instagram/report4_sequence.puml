@startuml 3.8.1a - Connect Facebook & Instagram Account
title Sequence Diagram — 3.8.1a - Connect Facebook & Instagram Account

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

' === Participants ===
actor "User" as user
boundary "SocialAccountsPage (UI)" as ui
boundary "SocialOAuthController" as ctrl
control "MetaOAuthService" as oauthSvc
entity "SocialAccountService" as accountSvc
entity "Meta Graph API" as metaApi

' === Flow ===
user -> ui: clicks "Connect Facebook / Instagram"
activate ui
ui -> ctrl: GET /api/v1/oauth/social/connect?platform=META
activate ctrl
ctrl -> oauthSvc: buildAuthorizationUrl(platform)
activate oauthSvc
oauthSvc --> ctrl: authUrl
deactivate oauthSvc
ctrl --> ui: 302 Redirect to authUrl
deactivate ctrl
ui --> user: Meta OAuth Consent Screen

user -> metaApi: authorizes permissions
activate metaApi
metaApi --> ui: callback with authCode & state
deactivate metaApi

ui -> ctrl: GET /api/v1/oauth/social/callback?code=authCode&state=...
activate ctrl
ctrl -> oauthSvc: exchangeToken(authCode)
activate oauthSvc
oauthSvc -> metaApi: exchange short-lived token
activate metaApi
metaApi --> oauthSvc: long-lived token (60 days)
deactivate metaApi
oauthSvc -> metaApi: fetch linked Pages & Instagram accounts
activate metaApi
metaApi --> oauthSvc: accountInfo
deactivate metaApi

alt connection failed
  oauthSvc --> ctrl: 302 Redirect with error status
  deactivate oauthSvc
  ctrl --> ui: error redirect
  deactivate ctrl
  ui --> user: Show error "Connection cancelled or failed"
else connection success
  activate oauthSvc
  activate ctrl
  oauthSvc -> accountSvc: syncSocialAccount(userId, accountInfo, encryptedToken)
  activate accountSvc
  accountSvc --> oauthSvc: savedAccount
  deactivate accountSvc
  oauthSvc --> ctrl: 302 Redirect with success status
  deactivate oauthSvc
  ctrl --> ui: redirect to SocialAccountsPage
  deactivate ctrl
  ui --> user: Show Facebook/Instagram channel card as connected
  deactivate ui
end

@enduml