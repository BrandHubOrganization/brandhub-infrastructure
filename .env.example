# Root environment variables for repository tooling (e.g., scripts/jira/export-jira.js)
# Copy this file to .env and fill in your credentials. Never commit .env.
# Note: Docker Compose runtime variables live separately in docker/compose/.env.example.

JIRA_SITE=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
